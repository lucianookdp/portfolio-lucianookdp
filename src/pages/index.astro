---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import About from '../components/sections/About.astro';
import Projects from '../components/sections/Projects.astro';
import Services from '../components/sections/Services.astro';
import StackActivity from '../components/sections/StackActivity.astro';
import Contact from '../components/sections/Contact.astro';
import { getDictionary } from '../i18n/utils';

const locale = 'pt' as const;
const dict = getDictionary(locale);
---

<BaseLayout locale={locale} ptPath="/" enPath="/en">
  <Hero dict={dict} locale={locale} displayName="Luciano K. Dal Pai" />
  <About dict={dict} />
  <Projects dict={dict} locale={locale} />
  <Services dict={dict} />
  <Contact dict={dict} />
  <StackActivity dict={dict} locale={locale} />
</BaseLayout>
