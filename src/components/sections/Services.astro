---
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import type { Dictionary } from '../../i18n/utils';
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const { labels, offerings } = dict.services;
const number = (i: number) => String(i + 1).padStart(2, '0');
---
<section id="services" class="container-site scroll-mt-24 py-16 sm:py-24 lg:py-32">
  <SectionHeading index={dict.services.index} heading={dict.services.heading} subheading={dict.services.subheading} />
  <p class="service-introduction">{dict.services.intro}</p>
  <nav class="service-chooser" aria-labelledby="service-chooser-heading">
    <h3 id="service-chooser-heading" class="eyebrow">{dict.services.chooserHeading}</h3>
    <ul class="service-options">{offerings.map((o)=><li><a href={`#${o.id}`} class="offering"><span class="offering-head"><span class="offering-icon"><ServiceIcon kind={o.kind} /></span><span aria-hidden="true">↗</span></span><span class="offering-title">{o.title}</span><span class="offering-need">{o.need}</span></a></li>)}</ul>
    <p class="service-help">{dict.services.chooserHelp} <a href="#contact">{dict.services.chooserHelpLink} ↗</a></p>
  </nav>
  <div class="service-list">
    {offerings.map((offering, index) => (
      <article id={offering.id} class="service-block scroll-mt-24" aria-labelledby={`${offering.id}-title`}>
        <header class="service-intro" data-reveal>
          <span class="service-emblem"><ServiceIcon kind={offering.kind} /></span>
          <p class="service-kicker"><span>{number(index)}</span>{offering.kicker}</p>
          <h3 id={`${offering.id}-title`} class="service-title">{offering.title}</h3>
          <p class="service-lead">{offering.what}</p>
        </header>
        <div class="service-details">
          <div class="service-accordions">
            <details>
              <summary>{labels.when}<span aria-hidden="true">+</span></summary>
              <ul class="service-bullets">{offering.when.map(item => <li>{item}</li>)}</ul>
            </details>
            <details>
              <summary>{labels.includes}<span aria-hidden="true">+</span></summary>
              <ul class="service-bullets">{offering.includes.map(item => <li>{item}</li>)}</ul>
            </details>
            <details>
              <summary>{labels.practice}<span aria-hidden="true">+</span></summary>
              <p class="service-practice">{offering.practice}</p>
            </details>
          </div>
          <div class="service-next">
            <p>{offering.nextStep}</p>
            <a href="#contact" class="btn btn-primary btn-sm service-cta">{offering.cta}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
<style is:global>
#services{--s-dim:var(--color-text-secondary);--s-ink:var(--color-text);--s-edge:var(--color-border-strong);--s-line:var(--color-border);--s-green:var(--color-accent-text);--s-soft:var(--color-accent-soft);--s-paper:var(--color-bg-elevated);--s-bg:var(--color-bg);--s-accent:var(--color-accent);--s-on:var(--color-on-accent)}
.service-introduction{max-width:55ch;margin-top:2.5rem;font:500 clamp(1.15rem,2vw,1.65rem)/1.5 var(--font-display);letter-spacing:-.02em}
.service-chooser{margin-top:3rem}.service-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:1rem;border-block:1px solid var(--s-edge)}
.offering{display:flex;flex-direction:column;height:100%;padding:1.3rem 1rem;border-right:1px solid var(--s-line);color:var(--s-ink);transition:background .3s}.service-options li:nth-child(2n) .offering{border-right:0}.service-options li:nth-child(-n+2){border-bottom:1px solid var(--s-line)}
.offering-head{display:flex;justify-content:space-between;color:var(--s-green);font:.7rem var(--font-mono)}.offering-head>span:last-child{font-size:1.1rem;transition:transform .3s}.offering-title{font:600 1.1rem/1.2 var(--font-display);letter-spacing:-.025em;margin-top:1rem}.offering-need{font-size:.8rem;line-height:1.55;color:var(--s-dim);margin-top:.6rem}
.offering:hover,.offering:focus-visible{background:var(--s-soft)}.offering:focus-visible{outline:2px solid var(--s-green);outline-offset:-2px}.offering:hover .offering-head>span:last-child{transform:translate(2px,-2px)}
.service-help{margin-top:1rem;font-size:.8rem;line-height:1.6;color:var(--s-dim)}.service-help a{color:var(--s-green);text-decoration:underline;text-underline-offset:4px}
.service-list{display:grid;gap:3.5rem;margin-top:2rem}.service-block{display:grid;gap:1.75rem;padding-top:2rem;border-top:1px solid var(--s-edge)}
.offering-icon{display:grid;place-items:center;width:3rem;height:3rem;border:1px solid var(--s-line);border-radius:.85rem;background:var(--s-soft)}
.offering-icon svg{width:1.65rem;height:1.65rem}
.service-emblem{display:grid;place-items:center;width:4.5rem;height:4.5rem;margin-bottom:1.4rem;border:1px solid var(--s-edge);border-radius:1.2rem;color:var(--s-green);background:linear-gradient(145deg,var(--s-soft),var(--s-paper))}
.service-emblem svg{width:2.5rem;height:2.5rem}
@media(prefers-reduced-motion:no-preference){.offering-icon svg{transition:transform .35s var(--ease-out-expo)}.offering:hover .offering-icon svg{transform:translateY(-2px) rotate(-4deg)}}
.service-kicker{display:flex;align-items:center;gap:.8rem;color:var(--s-dim);font:.65rem/1.5 var(--font-mono);text-transform:uppercase;letter-spacing:.1em}.service-kicker>span{display:grid;place-items:center;width:2rem;height:2rem;flex:none;border:1px solid var(--s-edge);border-radius:50%;color:var(--s-green)}
.service-title{font:600 clamp(2rem,4vw,3rem)/1.06 var(--font-display);letter-spacing:-.045em;margin:1rem 0 1.25rem;max-width:18ch}.service-lead{font-size:1rem;line-height:1.65;max-width:53ch;color:var(--s-dim)}
.service-accordions{border-top:1px solid var(--s-line)}.service-accordions details{border-bottom:1px solid var(--s-line)}.service-accordions summary{display:flex;justify-content:space-between;align-items:center;gap:1rem;min-height:52px;cursor:pointer;font-size:.85rem;font-weight:500;list-style:none}.service-accordions summary::-webkit-details-marker{display:none}.service-accordions summary>span{color:var(--s-green);font-size:1.25rem}.service-accordions details[open] summary>span{transform:rotate(45deg)}.service-accordions summary:focus-visible{outline:2px solid var(--s-green);outline-offset:4px}
.service-bullets{display:grid;gap:.5rem;padding:0 0 1rem 1rem;list-style:disc;font-size:.85rem;line-height:1.6;color:var(--s-dim)}.service-bullets li::marker{color:var(--s-green)}.service-practice{font-size:.8rem;line-height:1.65;color:var(--s-dim);padding-bottom:1rem}.service-next{margin-top:1.5rem}.service-next p{font-size:.8rem;line-height:1.6;color:var(--s-dim);margin-bottom:1rem;max-width:45ch}.service-cta{white-space:normal;line-height:1.4;text-align:left;gap:.75rem}
@media (min-width: 768px) {
  .service-options { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .service-options li:nth-child(-n+2) { border-bottom: 0; }
  .service-options li:nth-child(2) .offering { border-right: 1px solid var(--s-line); }
  .offering { padding: 1.5rem; }
  .service-block { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; }
  .service-list { gap: 4rem; margin-top: 3.5rem; }
}
@media (prefers-reduced-motion: reduce) {
  .offering, .offering-head > span:last-child { transition: none; }
  .offering:hover .offering-head > span:last-child { transform: none; }
}
</style>
