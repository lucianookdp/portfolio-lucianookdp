---
import type { Dictionary, Locale } from '../../i18n/utils';
import Logo from '../ui/Logo.astro';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const year = new Date().getFullYear();

const sectionPrefix = ['/', '/en', '/en/'].includes(Astro.url.pathname) ? '' : (locale === 'pt' ? '/' : '/en');
const navItems = [
  { href: '#about', label: dict.nav.about },
  { href: '#projects', label: dict.nav.projects },
  { href: '#services', label: dict.nav.services },
  { href: '#contact', label: dict.nav.contact },
  { href: '#stack', label: dict.nav.stack }
].map(item => ({ ...item, href: `${sectionPrefix}${item.href}` }));
---

<footer class="relative overflow-hidden border-t border-[var(--color-border)]">
  <div class="container-site relative py-12 sm:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.4fr_2fr] md:gap-12">
      <div class="flex flex-col gap-5" data-reveal>
        <a href={locale === 'pt' ? '/' : '/en'} class="inline-flex w-fit items-center text-[var(--color-text)] transition-opacity duration-200 hover:opacity-80" aria-label="lucianookdp">
          <Logo class="h-11 w-auto" />
        </a>
        <p class="max-w-xs font-sans text-sm leading-relaxed text-[var(--color-text-secondary)]">{dict.hero.tagline}</p>
      </div>

      <div class="grid grid-cols-2 gap-8" data-reveal data-reveal-delay="80">
      <div>
        <p class="eyebrow">{dict.footer.navigate}</p>
        <ul class="mt-4 flex flex-col gap-2 font-sans text-sm">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text)]">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow">{dict.footer.elsewhere}</p>
        <ul class="mt-4 flex flex-col gap-2 font-sans text-sm">
          <li>
            <a href="https://github.com/lucianookdp" target="_blank" rel="noopener noreferrer me" class="text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text)]">GitHub ↗</a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/lucianookdp/" target="_blank" rel="noopener noreferrer me" class="text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text)]">LinkedIn ↗</a>
          </li>
        </ul>
      </div>
      </div>
    </div>

    <div class="mt-12 border-t border-[var(--color-border)] pt-6 font-sans text-xs text-[var(--color-text-secondary)] sm:mt-14" data-reveal>
      <p>&copy; {year} Luciano K. Dal Pai. {dict.footer.rights}</p>
    </div>
  </div>

  <div class="pointer-events-none select-none px-6 text-[var(--color-text)] opacity-[0.06]" aria-hidden="true">
    <Logo variant="wordmark" class="mx-auto block h-auto w-full max-w-[72rem]" style="margin-bottom: -2.2%;" />
  </div>
</footer>
