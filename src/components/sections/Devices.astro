---
import SectionHeading from '../ui/SectionHeading.astro';
import RevealText from '../ui/RevealText.astro';
import type { Dictionary } from '../../i18n/utils';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const { labels, mock } = dict.devices;

// Each device lays the same content out its own way (not a scaled copy of
// the desktop). data-device marks where the stage 2 3D models will sit.
const DEVICES = [
  { id: 'desktop', label: labels.desktop },
  { id: 'tablet', label: labels.tablet },
  { id: 'phone', label: labels.phone }
] as const;

const POINT_ICONS = [
  `<path d="M4 7V5h16v2" /><path d="M12 5v14" /><path d="M9 19h6" />`,
  `<path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h10" />`,
  `<path d="M9 11V6a2 2 0 1 1 4 0v5" /><path d="M13 9.5a2 2 0 1 1 4 0V14a6 6 0 0 1-6 6h-.5a5.5 5.5 0 0 1-4.7-2.6L4 14.5a1.6 1.6 0 0 1 2.6-1.8L9 15" />`,
  `<rect x="3" y="4" width="7" height="7" rx="1.5" /><rect x="14" y="4" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" />`
];
---

<section id="devices" class="container-site scroll-mt-24 py-16 sm:py-24 lg:py-32">
  <SectionHeading index={dict.devices.index} heading={dict.devices.heading} subheading={dict.devices.subheading} />

  <div class="mt-8 grid gap-8 sm:mt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
    <RevealText as="p" class="max-w-2xl font-display text-xl font-medium leading-snug tracking-tight sm:text-2xl">
      {dict.devices.body}
    </RevealText>
    <ul class="devices-points">
      {dict.devices.points.map((point, index) => (
        <li data-reveal data-reveal-delay={index * 70}>
          <span class="devices-point-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={POINT_ICONS[index]} /></span>
          <span>
            <span class="devices-point-title">{point.title}</span>
            <span class="devices-point-text">{point.description}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>

  <figure class="devices-figure" data-reveal>
    <div class="devices-stage" data-devices aria-hidden="true">
      {DEVICES.map((device) => (
        <div class={`device device-${device.id}`} data-device={device.id}>
          <div class="device-shell">
            <div class="device-screen">
              <div class="dm-nav">
                <span class="dm-brand"><i></i><span>{mock.brand}</span></span>
                {device.id === 'phone' ? (
                  <span class="dm-burger"><i></i><i></i></span>
                ) : (
                  <span class="dm-links">
                    {(device.id === 'desktop' ? [0, 1, 2, 3] : [0, 1]).map(() => <i></i>)}
                    <b>{mock.button}</b>
                  </span>
                )}
              </div>
              <div class="dm-hero">
                <div class="dm-copy">
                  <span class="dm-title">{mock.title}</span>
                  <span class="dm-line" style="--w: 92%"></span>
                  <span class="dm-line" style="--w: 70%"></span>
                  <span class="dm-button">{mock.button}</span>
                </div>
                <span class="dm-media"></span>
              </div>
              <div class="dm-cards">
                {[0, 1, 2].map(() => <span class="dm-card"><i></i><span class="dm-line" style="--w: 80%"></span><span class="dm-line" style="--w: 55%"></span></span>)}
              </div>
            </div>
          </div>
          <span class="device-label">{device.label}</span>
        </div>
      ))}
    </div>
    <figcaption class="mt-4 font-sans text-sm text-[var(--color-text-secondary)]">{dict.devices.caption}</figcaption>
  </figure>
</section>

<!-- Global styles: every class here is device-, dm- and devices-prefixed, and skipping Astro's
     per-selector scope attribute keeps the page CSS within budget. -->
<style is:global>
  .devices-points { display: grid; gap: 1.25rem; }
  .devices-points li { display: flex; gap: 0.875rem; }
  .devices-point-icon { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border: 1px solid var(--color-border-strong); border-radius: 0.875rem; background: var(--color-accent-soft); color: var(--color-accent-text); }
  .devices-point-icon svg { width: 1.25rem; height: 1.25rem; }
  .devices-point-title { display: block; font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; line-height: 1.3; }
  .devices-point-text { display: block; margin-top: 0.25rem; color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.6; }
  @media (min-width: 640px) { .devices-points { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 2rem; } }

  .devices-figure { margin: 3rem 0 0; }
  .devices-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem 1rem;
    padding: 1.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: radial-gradient(circle at 20% 0%, var(--color-accent-soft), transparent 55%), var(--color-bg-elevated);
  }
  .device-desktop { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .devices-stage { grid-template-columns: minmax(0, 4fr) minmax(0, 2fr) minmax(0, 1fr); gap: 2rem; padding: 2.5rem; }
    .device-desktop { grid-column: auto; }
  }

  .device { display: grid; justify-items: center; gap: 0.75rem; min-width: 0; }
  .device-label { color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .device-shell { container-type: inline-size; width: 100%; padding: 0.5rem; border: 1px solid var(--color-border-strong); border-radius: 1rem; background: var(--color-bg-subtle); box-shadow: var(--shadow-card); }
  .device-screen { overflow: hidden; border-radius: 0.5rem; background: var(--color-bg); color: var(--color-text); font-family: var(--font-sans); }
  .device-desktop .device-screen { aspect-ratio: 16 / 10; }
  .device-tablet .device-shell { border-radius: 1.25rem; padding: 0.625rem; }
  .device-tablet .device-screen { aspect-ratio: 3 / 4; border-radius: 0.625rem; }
  .device-phone .device-shell { border-radius: 1.5rem; padding: 0.375rem; }
  .device-phone .device-screen { aspect-ratio: 9 / 19; border-radius: 1.125rem; }
  .device-tablet { width: 100%; }
  .device-phone { width: 62%; justify-self: center; }
  @media (min-width: 900px) { .device-phone { width: 100%; } }

  /* Mock content: sizes in cqw (the shell is the container), so each screen
     scales with its own width. */
  .device-screen { display: flex; flex-direction: column; gap: 4cqw; padding: 4cqw; }
  .dm-nav { display: flex; align-items: center; justify-content: space-between; gap: 2cqw; }
  .dm-brand { display: inline-flex; align-items: center; gap: 1.5cqw; font-size: 2.4cqw; font-weight: 600; white-space: nowrap; }
  .dm-brand i { width: 3cqw; height: 3cqw; border-radius: 0.8cqw; background: var(--color-accent); }
  .dm-links { display: inline-flex; align-items: center; gap: 2.5cqw; }
  .dm-links i { width: 7cqw; height: 1.2cqw; border-radius: 99px; background: color-mix(in srgb, var(--color-text) 18%, transparent); }
  .dm-links b { padding: 1cqw 2.2cqw; border-radius: 99px; background: var(--color-text); color: var(--color-bg); font-size: 1.8cqw; font-weight: 600; white-space: nowrap; }
  .dm-burger { display: grid; gap: 2cqw; width: 8cqw; }
  .dm-burger i { height: 1.2cqw; border-radius: 99px; background: var(--color-text); }
  .dm-hero { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 4cqw; }
  .dm-copy { display: grid; gap: 2cqw; }
  .dm-title { font-family: var(--font-display); font-size: 4.6cqw; font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; }
  .dm-line { display: block; width: var(--w); height: 1.4cqw; border-radius: 99px; background: color-mix(in srgb, var(--color-text) 14%, transparent); }
  .dm-button { width: fit-content; margin-top: 1cqw; padding: 1.4cqw 3cqw; border-radius: 99px; background: var(--color-accent); color: var(--color-on-accent); font-size: 1.9cqw; font-weight: 600; white-space: nowrap; }
  .dm-media { aspect-ratio: 4 / 3; border-radius: 2cqw; background: linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 45%, transparent), color-mix(in srgb, var(--color-accent-2) 15%, transparent)); }
  .dm-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5cqw; }
  .dm-card { display: grid; gap: 1.5cqw; padding: 2.5cqw; border: 1px solid var(--color-border); border-radius: 1.6cqw; background: var(--color-bg-elevated); }
  .dm-card i { width: 4cqw; height: 4cqw; border-radius: 1cqw; background: var(--color-accent-soft); }

  /* Tablet: image above the text, cards in two columns. */
  .device-tablet .device-screen { gap: 5cqw; padding: 5cqw; }
  .device-tablet .dm-brand { font-size: 4cqw; }
  .device-tablet .dm-brand i { width: 5cqw; height: 5cqw; }
  .device-tablet .dm-links i { width: 10cqw; height: 2cqw; }
  .device-tablet .dm-links b { font-size: 3.2cqw; padding: 1.8cqw 3.5cqw; }
  .device-tablet .dm-hero { grid-template-columns: 1fr; }
  .device-tablet .dm-media { order: -1; aspect-ratio: 16 / 9; }
  .device-tablet .dm-title { font-size: 8cqw; }
  .device-tablet .dm-line { height: 2.2cqw; }
  .device-tablet .dm-button { font-size: 3.6cqw; padding: 2.4cqw 5cqw; }
  .device-tablet .dm-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4cqw; }
  .device-tablet .dm-card:last-child { display: none; }
  .device-tablet .dm-card { padding: 4cqw; gap: 2.5cqw; border-radius: 3cqw; }
  .device-tablet .dm-card i { width: 7cqw; height: 7cqw; }

  /* Phone: menu folds into a button, one column, a wide tap target. */
  .device-phone .device-screen { gap: 7cqw; padding: 10cqw 7cqw 7cqw; }
  .device-phone .dm-brand { font-size: 7cqw; gap: 3cqw; }
  .device-phone .dm-brand i { width: 8cqw; height: 8cqw; border-radius: 2cqw; }
  .device-phone .dm-burger i { height: 2cqw; }
  .device-phone .dm-burger { gap: 3.5cqw; width: 11cqw; }
  .device-phone .dm-hero { grid-template-columns: 1fr; gap: 7cqw; }
  .device-phone .dm-copy { gap: 4cqw; }
  .device-phone .dm-title { font-size: 13cqw; }
  .device-phone .dm-line { height: 3.5cqw; }
  .device-phone .dm-button { width: 100%; margin-top: 2cqw; padding: 5cqw 0; font-size: 6cqw; text-align: center; border-radius: 6cqw; }
  .device-phone .dm-media { aspect-ratio: 4 / 3; border-radius: 5cqw; }
  .device-phone .dm-cards { grid-template-columns: 1fr; gap: 5cqw; }
  .device-phone .dm-card { padding: 6cqw; gap: 4cqw; border-radius: 5cqw; }
  .device-phone .dm-card i { width: 10cqw; height: 10cqw; border-radius: 3cqw; }

  @media (prefers-reduced-motion: no-preference) {
    .device-shell { transition: transform 600ms var(--ease-out-expo); }
    .devices-figure.is-revealed .device-tablet .device-shell { animation: device-rise 900ms var(--ease-out-expo) 120ms both; }
    .devices-figure.is-revealed .device-phone .device-shell { animation: device-rise 900ms var(--ease-out-expo) 240ms both; }
  }
  @keyframes device-rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
</style>
