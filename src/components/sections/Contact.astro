---
import RevealText from '../ui/RevealText.astro';
import ObfuscatedEmail from '../islands/ObfuscatedEmail.tsx';
import type { Dictionary } from '../../i18n/utils';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section id="contact" class="container-site scroll-mt-24 py-16 sm:py-24 lg:py-32">
  <div class="card relative overflow-hidden px-5 py-12 sm:px-12 sm:py-24 lg:px-20">
    <div class="aurora" aria-hidden="true"><span class="aurora-blob"></span></div>
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="relative flex flex-col items-start gap-6 sm:gap-8">
      <p class="eyebrow flex items-center gap-3" data-reveal>
        <span class="text-[var(--color-accent-text)]">({dict.contact.index})</span>
        <span class="h-px w-8 bg-[var(--color-border-strong)]" aria-hidden="true"></span>
        <span>{dict.contact.heading}</span>
      </p>

      <RevealText as="h2" class="max-w-4xl font-display text-3xl font-semibold leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">
        {dict.contact.title}
      </RevealText>

      <p class="max-w-xl font-sans text-base text-[var(--color-text-secondary)] sm:text-lg" data-reveal>{dict.contact.subheading}</p>

      <div data-reveal data-reveal-delay="120" class="w-full">
        <ObfuscatedEmail
          client:load
          userPart="engslucianok"
          domainPart="gmail"
          tldPart="com"
          loadingLabel={dict.contact.loadingEmail}
          copyLabel={dict.contact.copyEmail}
          copiedLabel={dict.contact.emailCopied}
          sendLabel={dict.contact.sendEmail}
          emailSubject={dict.contact.emailSubject}
          copyErrorLabel={dict.contact.copyError}
        />
      </div>

      <div class="flex w-full flex-col gap-3 border-t border-[var(--color-border)] pt-4 font-mono text-[11px] leading-relaxed text-[var(--color-text-secondary)] sm:flex-row sm:items-center sm:justify-between sm:gap-6" data-reveal data-reveal-delay="200">
        <p class="flex items-center gap-2">
          <span class="flex h-3.5 w-3.5 shrink-0 items-center justify-center" aria-hidden="true">
            <span class="availability-dot h-1.5 w-1.5 rounded-full bg-[var(--color-accent-2-glow)]"></span>
          </span>
          <span>{dict.contact.responseTime}</span>
        </p>
        <p class="flex items-center gap-2">
          <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
          </svg>
          <span>{dict.hero.localTime}: <span data-local-time class="tabular-nums text-[var(--color-text)]">--:--</span></span>
        </p>
      </div>
    </div>
  </div>
</section>
