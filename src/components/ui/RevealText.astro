---
interface Props {
  as?: 'h2' | 'h3' | 'p' | 'div';
  class?: string;
  id?: string;
}

const { as: Tag = 'div', class: className = '', id }: Props = Astro.props;
---

<Tag class={`reveal-text ${className}`} id={id}>
  <slot />
</Tag>

<script>
  import { animate, stagger } from 'motion';

  // Line-by-line reveal. The element's text is measured word by word to find
  // the natural line breaks, then each line is wrapped in an overflow-hidden
  // block so it can slide up into view. Measuring only happens once the page
  // has fully loaded and fonts are ready, since a split taken against an
  // unfinished layout freezes the wrong line breaks in place.
  const originalText = new WeakMap<HTMLElement, string>();
  const runningAnimations = new WeakMap<HTMLElement, { complete: () => void }>();
  let observer: IntersectionObserver | null = null;

  function splitIntoLines(el: HTMLElement) {
    const text = (originalText.get(el) ?? el.textContent ?? '').trim();
    if (!text) return;
    originalText.set(el, text);

    const words = text.split(/\s+/);
    el.textContent = '';
    words.forEach((word, i) => {
      const span = document.createElement('span');
      span.className = 'reveal-word';
      span.style.display = 'inline-block';
      span.textContent = word;
      el.appendChild(span);
      if (i < words.length - 1) el.appendChild(document.createTextNode(' '));
    });

    const wordSpans = Array.from(el.querySelectorAll<HTMLElement>(':scope > .reveal-word'));
    const lines: HTMLElement[][] = [];
    let lastTop: number | null = null;
    wordSpans.forEach((span) => {
      const top = span.offsetTop;
      if (lastTop === null || Math.abs(top - lastTop) > 2) {
        lines.push([]);
        lastTop = top;
      }
      lines[lines.length - 1].push(span);
    });

    el.textContent = '';
    lines.forEach((lineWords) => {
      const lineEl = document.createElement('span');
      lineEl.className = 'reveal-line';
      const innerEl = document.createElement('span');
      innerEl.className = 'reveal-line-inner';
      lineWords.forEach((span, idx) => {
        innerEl.appendChild(document.createTextNode(span.textContent ?? ''));
        if (idx < lineWords.length - 1) innerEl.appendChild(document.createTextNode(' '));
      });
      lineEl.appendChild(innerEl);
      el.appendChild(lineEl);
    });
  }

  function restoreText(el: HTMLElement) {
    const text = originalText.get(el);
    if (text !== undefined) el.textContent = text;
  }

  function showLines(root: HTMLElement) {
    root.querySelectorAll<HTMLElement>('.reveal-line-inner').forEach((line) => {
      line.style.transform = 'translateY(0%)';
      line.style.opacity = '1';
    });
  }

  function prepare(root: HTMLElement) {
    root.dataset.revealReady = 'true';
    const targets = root.children.length > 0 ? Array.from(root.children) : [root];
    targets.forEach((target) => {
      if (target instanceof HTMLElement) splitIntoLines(target);
    });
  }

  function initRevealText() {
    const roots = Array.from(document.querySelectorAll<HTMLElement>('.reveal-text:not([data-reveal-ready])'));
    if (roots.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      roots.forEach((root) => (root.dataset.revealReady = 'true'));
      return;
    }

    observer?.disconnect();
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const root = entry.target as HTMLElement;
          root.dataset.revealed = 'true';
          const lines = root.querySelectorAll<HTMLElement>('.reveal-line-inner');
          const controls = animate(
            lines,
            { transform: 'translateY(0%)', opacity: 1 },
            { duration: 0.8, delay: stagger(0.08), ease: [0.16, 1, 0.3, 1] }
          );
          runningAnimations.set(root, controls);
          observer?.unobserve(root);
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
    );

    roots.forEach((root) => {
      prepare(root);
      // Already on screen (refresh mid-scroll, or a direct #section link):
      // just show it rather than animating something the visitor can't watch.
      const rect = root.getBoundingClientRect();
      const alreadyVisible = rect.top < window.innerHeight * 0.85 && rect.bottom > 0;
      if (alreadyVisible) {
        root.dataset.revealed = 'true';
        showLines(root);
        return;
      }
      observer?.observe(root);
    });

    scheduleSafetyCheck();
  }

  // Once a root is revealed its line wrappers only get in the way (frozen
  // breaks on resize), so put the plain text back. Unrevealed roots are
  // re-measured against the new layout.
  let resizeTimer: number | undefined;
  let lastWidth = window.innerWidth;
  function onResize() {
    if (window.innerWidth === lastWidth) return;
    lastWidth = window.innerWidth;
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      document.querySelectorAll<HTMLElement>('.reveal-text[data-reveal-ready]').forEach((root) => {
        const targets = root.children.length > 0 && !root.querySelector('.reveal-line') ? Array.from(root.children) : [root];
        const revealed = root.dataset.revealed === 'true';
        targets.forEach((target) => {
          if (!(target instanceof HTMLElement)) return;
          restoreText(target);
          if (!revealed) splitIntoLines(target);
        });
        if (revealed) observer?.unobserve(root);
      });
    }, 200);
  }
  window.addEventListener('resize', onResize, { passive: true });

  // Safety net: if an IntersectionObserver callback is missed or throttled
  // (tab backgrounded as an element scrolled in), text would stay invisible.
  // Anything on screen but still hidden gets shown immediately.
  let safetyTimer: number | undefined;
  function forceRevealIfVisible() {
    document.querySelectorAll<HTMLElement>('.reveal-text[data-reveal-ready]').forEach((root) => {
      const lines = root.querySelectorAll<HTMLElement>('.reveal-line-inner');
      if (lines.length === 0) return;
      const stillHidden = Array.from(lines).some((line) => getComputedStyle(line).opacity === '0');
      if (!stillHidden) return;
      const rect = root.getBoundingClientRect();
      if (!(rect.top < window.innerHeight && rect.bottom > 0)) return;
      root.dataset.revealed = 'true';
      const controls = runningAnimations.get(root);
      if (controls) controls.complete();
      else showLines(root);
    });
  }
  function scheduleSafetyCheck() {
    window.clearTimeout(safetyTimer);
    safetyTimer = window.setTimeout(forceRevealIfVisible, 1200);
  }
  window.addEventListener('scroll', scheduleSafetyCheck, { passive: true });

  function onPageLoad() {
    // Two frames after fonts settle so the layout the split measures against
    // is the final one.
    document.fonts.ready.then(() => {
      requestAnimationFrame(() => requestAnimationFrame(initRevealText));
    });
    // A hidden tab never gets a frame; don't leave the split waiting forever.
    window.setTimeout(initRevealText, 600);
  }

  document.addEventListener('astro:page-load', onPageLoad);
</script>
