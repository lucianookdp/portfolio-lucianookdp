---
import ServiceRoom from './ServiceRoom.astro';
import type { Dictionary } from '../../i18n/utils';
interface Props { kind: string; badge: string; demo: Dictionary['services']['demo']; visual: Dictionary['services']['offerings'][number]['visual']; }
const { kind, visual, badge, demo: d } = Astro.props;
const { sequence } = visual;
---
<figure class={`sv sv-${kind}`} data-service-visual={kind}>
  <div class="sv-example"><span>{d.example}</span><span>{kind === 'landing' || kind === 'website' ? d.business : d.request}</span></div>
  <div class="sv-frame">
    <div class="sv-chrome" aria-hidden="true"><span class="sv-dots">● ● ●</span><span>{kind === 'landing' ? 'forma.exemplo / organizar' : kind === 'website' ? 'forma.exemplo' : kind === 'webapp' ? d.workspace : d.flow}</span><span class="sv-badge">{badge}</span></div>
    <div class="sv-screen" aria-hidden="true">
      {kind === 'landing' && <div class="sv-landing-page">
        <div class="sv-nav"><b>forma</b><span>{d.organizing}</span></div>
        <div class="sv-offer" data-cue="0"><div><span class="sv-overline">{d.home}</span><strong class="sv-title">{d.headline}</strong><p>{d.subtitle}</p><span class="sv-button">{d.landingAction} ↗</span></div><ServiceRoom /></div>
        <div class="sv-benefits" data-cue="1">{d.benefits.map((benefit,i)=><div><span>0{i+1}</span><b>{benefit}</b></div>)}</div>
        <div class="sv-contact" data-cue="2"><div><b>{d.start}</b><p>{d.tellSpace}</p></div><span class="sv-button">{d.contact} ↗</span></div>
      </div>}
      {kind === 'website' && <>
        <div class="sv-nav"><b>forma</b><nav>{d.pages.map((page,i)=><span data-cue={i}>{page}</span>)}</nav></div>
        <div class="sv-pages">
          <div class="sv-page" data-cue="0"><span class="sv-overline">{d.pages[0]}</span><strong class="sv-title">{d.companyTitle}</strong><div class="sv-company"><p>{d.companyText}</p><ServiceRoom /></div><span class="sv-page-link">{d.explore} ↗</span></div>
          <div class="sv-page" data-cue="1"><span class="sv-overline">{d.pages[1]}</span><strong class="sv-title">{d.servicesTitle}</strong><div class="sv-catalog">{d.rooms.map((room,i)=><div><span>{['⌂','▤','▦'][i]}</span><b>{room}</b><small>{d.serviceDetails[i]}</small></div>)}</div></div>
          <div class="sv-page" data-cue="2"><span class="sv-overline">{d.pages[2]}</span><strong class="sv-title">{d.talk}</strong><p>{d.tellSpace}</p><div class="sv-contact-card"><span>↗</span><div><b>{d.contact}</b><small>{d.contactHint}</small></div></div><div class="sv-location">⌖ {d.location}</div></div>
        </div>
        <div class="sv-site-footer"><span>forma / {d.organizing}</span><span>{d.pagesLabel}</span></div>
      </>}
      {kind === 'webapp' && <>
        <div class="sv-app-nav"><span class="sv-app-symbol">▦</span><b>{d.workspace}</b><span class="sv-demo-label">{d.fictional}</span></div>
        <div class="sv-workflow">
          <div class="sv-panel" data-cue="0"><span class="sv-overline">01 / {d.newRequest}</span><strong class="sv-title">{d.taskTitle}</strong><div class="sv-form"><div><small>{d.service}</small><b>{d.organizing}</b><span>⌄</span></div><div><small>{d.space}</small><b>{d.rooms[1]}</b><span>⌄</span></div></div><span class="sv-button">+ {d.createRequest}</span></div>
          <div class="sv-panel" data-cue="1"><span class="sv-overline">02 / {d.requestList}</span><strong class="sv-title">{d.listTitle}</strong><div class="sv-th"><span>{d.request}</span><span>Status</span></div><div class="sv-row"><div><small>#024</small><b>{d.taskTitle}</b></div><span class="sv-status">{d.statuses[0]}</span></div><p class="sv-list-note">↳ {d.listNote}</p></div>
          <div class="sv-panel" data-cue="2"><span class="sv-overline">03 / {d.follow}</span><strong class="sv-title">{d.followTitle}</strong><div class="sv-board">{d.statuses.map((s,i)=><div><span><i></i>{s}</span>{i===1 && <div class="sv-ticket"><small>#024</small><b>{d.taskTitle}</b><span>↗ {d.statuses[1]}</span></div>}</div>)}</div></div>
        </div>
      </>}
      {kind === 'automation' && <div class="sv-flow">
        <div class="sv-flow-head"><span class="sv-overline">{d.flow}</span><strong class="sv-title">{d.flowTitle}</strong></div>
        {d.nodes.map((node,i)=><>
          {i>0 && <div class="sv-connector" data-link={i}><span class="sv-packet"></span><small>{d.sameData} ↓</small></div>}
          <div class="sv-node" data-cue={i}><span class="sv-node-icon">{['↧','▤','↗'][i]}</span><div><small>0{i+1} / {node}</small><b>{[d.taskTitle,d.saved,d.notified][i]}</b></div><span class="sv-check">✓</span></div>
        </>)}
        <div class="sv-flow-note">#024 · {d.noCopy}</div>
      </div>}
    </div>
  </div>
  <div class="sv-steps" role="group" aria-label={d.controls}>
    {sequence.map((item,i)=><button type="button" data-story-step={i} aria-pressed="false" aria-label={`${i+1}. ${item.title}`}><span>0{i+1}</span><span>{item.title}</span><i></i></button>)}
  </div>
  <div class="sv-sequence">{sequence.map((item,i)=><p data-sequence><span>0{i+1} — </span>{item.text}</p>)}</div>
  <figcaption class="sv-caption">{visual.caption}</figcaption>
</figure>
<style is:global>
.sv{--sv-paper:var(--s-paper);margin:0 auto;width:100%;max-width:560px}
.sv-example{display:flex;justify-content:space-between;gap:1rem;margin-bottom:1rem;color:var(--s-dim);font-size:.75rem}.sv-example>span:first-child{color:var(--s-green);font:.65rem var(--font-mono);text-transform:uppercase;letter-spacing:.12em}
.sv-frame{border:1px solid var(--s-edge);border-radius:1rem;background:var(--sv-paper);box-shadow:0 24px 65px -40px var(--color-accent-glow);overflow:hidden;pointer-events:none}
.sv-chrome{display:flex;align-items:center;gap:1rem;padding:.8rem 1rem;border-bottom:1px solid var(--s-line);background:var(--s-bg);font:.625rem var(--font-mono);color:var(--s-dim)}.sv-chrome>span:nth-child(2){flex:1}.sv-dots{font-size:.5rem;color:var(--s-edge)}.sv-badge{font-size:.56rem;text-transform:uppercase;letter-spacing:.08em}
.sv-screen{padding:1rem;font-size:.8rem;line-height:1.5}.sv-screen p,.sv-screen small{color:var(--s-dim)}.sv-screen b{font-weight:600}.sv-screen small{font-size:.65rem}.sv-title{display:block;max-width:17ch;font:600 clamp(1.35rem,1.9vw,1.65rem)/1.1 var(--font-display);letter-spacing:-.035em;margin:.45rem 0 .65rem}.sv-overline{font:.58rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--s-green)}
.sv-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem;font-size:.62rem;color:var(--s-dim)}.sv-nav>b{font:600 1.5rem var(--font-display);letter-spacing:-.06em;color:var(--s-ink)}.sv-nav nav{display:flex;gap:1rem}.sv-nav nav span{border-bottom:2px solid transparent;padding:.4rem 0}
.sv-offer{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:.5rem;border-radius:.5rem}.sv-offer p{font-size:.75rem;margin-bottom:1rem}.sv-room{width:100%;color:var(--s-green)}.sv-button{display:inline-flex;align-items:center;gap:.5rem;background:var(--s-accent);color:var(--s-on);border-radius:.4rem;padding:.6rem .8rem;font-size:.65rem;font-weight:600;line-height:1.4}
.sv-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:.7rem 0;margin:.75rem 0;border-block:1px solid var(--s-line)}.sv-benefits>div{display:grid;gap:.35rem}.sv-benefits span{color:var(--s-green);font:.6rem var(--font-mono)}.sv-benefits b{font-size:.7rem;line-height:1.4}.sv-contact{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-radius:.5rem;padding:.65rem;background:var(--s-soft)}.sv-contact b{font-size:.8rem}.sv-contact p{font-size:.65rem;margin-top:.2rem}.sv-contact .sv-button{flex:none}
.sv-pages,.sv-workflow{display:grid;gap:1.25rem}.sv-page,.sv-panel{min-height:260px}.sv-page>p{max-width:32ch}.sv-company{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:1rem}.sv-company .sv-room{max-height:135px}.sv-catalog{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem}.sv-catalog>div{display:grid;align-content:start;gap:.5rem;border:1px solid var(--s-line);border-radius:.5rem;padding:.8rem}.sv-catalog>div>span{font-size:1.8rem;color:var(--s-green)}.sv-catalog b{font-size:.8rem}
.sv-contact-card{display:flex;gap:1rem;align-items:center;padding:1rem;margin:1.2rem 0;background:var(--s-soft);border-radius:.5rem}.sv-contact-card>span{font-size:1.5rem;color:var(--s-green)}.sv-contact-card small{display:block;margin-top:.2rem}.sv-location{font-size:.7rem;color:var(--s-dim)}.sv-site-footer{display:flex;justify-content:space-between;border-top:1px solid var(--s-line);padding-top:.8rem;margin-top:1rem;font-size:.6rem;color:var(--s-dim)}
.sv-app-nav{display:flex;align-items:center;gap:.6rem;margin-bottom:1.5rem;padding-bottom:.9rem;border-bottom:1px solid var(--s-line)}.sv-app-symbol{color:var(--s-green);font-size:1.2rem}.sv-demo-label{margin-left:auto;font-size:.58rem;color:var(--s-dim)}.sv-form{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin:1.3rem 0}.sv-form>div{position:relative;display:grid;gap:.4rem;padding:.8rem;border:1px solid var(--s-edge);border-radius:.45rem;background:var(--s-bg)}.sv-form b{font-size:.75rem}.sv-form span{position:absolute;right:.75rem;top:.75rem;color:var(--s-dim)}
.sv-th,.sv-row{display:flex;justify-content:space-between;align-items:center;gap:.7rem;padding:.85rem .7rem}.sv-th{font-size:.6rem;color:var(--s-dim);border-bottom:1px solid var(--s-line)}.sv-row{background:var(--s-soft);border-radius:.4rem;margin-top:.5rem}.sv-row b{display:block;font-size:.75rem}.sv-status{border:1px solid var(--s-edge);border-radius:2rem;padding:.3rem .5rem;font-size:.6rem;color:var(--s-green)}.sv-list-note{margin-top:1rem;font-size:.7rem}
.sv-board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin-top:1.4rem}.sv-board>div{min-height:150px;padding:.5rem;background:var(--s-bg);border:1px solid var(--s-line);border-radius:.4rem}.sv-board>div>span{display:flex;align-items:center;gap:.3rem;font-size:.57rem;color:var(--s-dim)}.sv-board i{width:4px;height:4px;border-radius:50%;background:var(--s-green)}.sv-ticket{display:grid;gap:.4rem;padding:.7rem .5rem;margin-top:1rem;border:1px solid var(--s-green);background:var(--s-soft);border-radius:.3rem}.sv-ticket b{font-size:.7rem;line-height:1.4}.sv-ticket>span{font-size:.55rem;color:var(--s-green)}
.sv-flow-head .sv-title{max-width:24ch;margin-bottom:1.4rem}.sv-node{display:flex;align-items:center;gap:.8rem;padding:.85rem;border:1px solid var(--s-edge);border-radius:.6rem;background:var(--s-bg)}.sv-node-icon{display:grid;place-items:center;width:2rem;height:2rem;background:var(--s-soft);border-radius:.45rem;color:var(--s-green);font-size:1.15rem}.sv-node small{font-size:.6rem}.sv-node b{display:block;font-size:.8rem}.sv-check{margin-left:auto;color:var(--s-green)}.sv-connector{position:relative;height:24px;margin-left:1.8rem;border-left:1px dashed var(--s-edge);padding-left:1rem}.sv-connector small{font-size:.52rem;line-height:24px}.sv-packet{position:absolute;left:-3px;top:0;width:5px;height:7px;background:var(--s-accent);border-radius:3px}.sv-flow-note{font:.6rem var(--font-mono);color:var(--s-dim);margin-top:1rem}
.sv-steps{display:none;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin-top:1.4rem}.sv-steps button{position:relative;display:flex;gap:.5rem;align-items:center;text-align:left;min-height:48px;padding:.5rem 0 .9rem;color:var(--s-dim);font-size:.7rem;line-height:1.35;border-bottom:2px solid var(--s-line);cursor:pointer}.sv-steps button i{position:absolute;bottom:-2px;left:0;right:0;height:2px;background:var(--s-accent);transform:scaleX(0);transform-origin:left}.sv-steps button[aria-pressed=true]{color:var(--s-ink)}.sv-steps button[aria-pressed=true] i{transform:scaleX(1)}.sv-steps button:focus-visible{outline:2px solid var(--s-green);outline-offset:4px;border-radius:2px}.sv-steps button:hover{color:var(--s-green)}
.sv-sequence{display:grid;gap:.5rem;margin-top:1rem;font-size:.8rem;color:var(--s-dim);line-height:1.5}.sv-sequence p>span{color:var(--s-green)}.sv-caption{font-size:.65rem;line-height:1.5;color:var(--s-dim);margin-top:.8rem;max-width:65ch}
@media(prefers-reduced-motion:no-preference){
.sv-animated .sv-steps{display:grid}.sv-animated .sv-sequence{min-height:2.4rem}.sv-animated [data-sequence]{display:none}.sv-animated [data-sequence].is-current{display:block;animation:sv-caption-in .35s both}
.sv-animated .sv-page,.sv-animated .sv-panel{grid-area:1/1;visibility:hidden;opacity:0;transform:translateX(18px);transition:transform .45s cubic-bezier(.2,.7,.2,1),opacity .3s,visibility .3s}.sv-animated .sv-page.is-cued,.sv-animated .sv-panel.is-cued{visibility:visible;opacity:1;transform:none}
.sv-animated .sv-offer,.sv-animated .sv-benefits,.sv-animated .sv-contact,.sv-animated .sv-node{transition:opacity .4s,transform .5s,box-shadow .4s;opacity:.78}.sv-animated .sv-offer.is-cued,.sv-animated .sv-benefits.is-cued,.sv-animated .sv-contact.is-cued,.sv-animated .sv-node.is-cued{opacity:1;transform:translateY(-2px)}.sv-animated .sv-node.is-cued{box-shadow:0 0 0 1px var(--s-green)}
.sv-animated .sv-contact.is-cued .sv-button{animation:sv-contact-in .55s both}.sv-animated .sv-panel.is-cued .sv-ticket{animation:sv-ticket-in .6s both}.sv-animated .sv-nav .is-cued{color:var(--s-green);border-color:currentColor}.sv-animated .sv-steps i{transition:transform .4s}
.sv-animated .sv-packet{transform:translateY(calc(clamp(0,var(--story-progress,0)*3 - 1,1)*17px))}.sv-animated [data-link="2"] .sv-packet{transform:translateY(calc(clamp(0,var(--story-progress,0)*3 - 2,1)*17px))}}
@keyframes sv-caption-in{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}@keyframes sv-contact-in{from{transform:scale(.94)}to{transform:scale(1)}}@keyframes sv-ticket-in{from{transform:translateX(-80%);opacity:0}to{transform:none;opacity:1}}
@media(max-width:639px){.sv-chrome{gap:.6rem;padding:.65rem .8rem}.sv-title{font-size:1.4rem}.sv-offer{grid-template-columns:1.25fr .85fr}.sv-offer p{font-size:.65rem}.sv-benefits{gap:.65rem}.sv-contact{padding:.7rem;gap:.5rem}.sv-steps{gap:.6rem;margin-top:1rem}.sv-steps button{font-size:.65rem;gap:.35rem}.sv-steps button>span:first-child{display:none}.sv-page,.sv-panel{min-height:245px}.sv-demo-label{max-width:9ch;text-align:right}}
</style>
