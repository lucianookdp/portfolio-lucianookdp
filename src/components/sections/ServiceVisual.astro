---
interface Props {
  kind: string;
  badge: string;
  visual: { caption: string; labels: string[]; details: string[]; states: string[]; action: string; sequence: {title: string; text: string}[] };
}
const { kind, visual, badge } = Astro.props;
const { labels, details, states, action, sequence } = visual;
---
<figure class={`sv sv-${kind}`} data-service-visual={kind}>
  <div class="sv-frame" aria-hidden="true">
    <div class="sv-chrome"><span class="sv-dots">● ● ●</span><span class="sv-address">{kind === 'landing' ? '/ ↘' : kind === 'website' ? '/ → / → /' : kind === 'webapp' ? '↳ / workspace' : '○ → ○ → ○'}</span><span class="sv-badge">{badge}</span></div>
    <div class="sv-body">
      {kind === 'landing' && <div class="sv-landing-page">
        <div class="sv-block sv-offer" data-part="hero" data-cue="0"><span class="sv-tag">01 / {labels[0]}</span><strong>{sequence[0].title}</strong><span class="sv-bar" style="--w:75%"></span><span class="sv-pill">{action}</span></div>
        <div class="sv-block" data-part="benefits" data-cue="1"><span class="sv-tag">02 / {labels[1]}</span><div class="sv-tiles">{[0,1,2].map(()=> <span class="sv-tile"><i>✓</i><span class="sv-bar"></span></span>)}</div></div>
        <div class="sv-block" data-part="info" data-cue="1"><span class="sv-tag">03 / {labels[2]}</span><span class="sv-bar" style="--w:90%"></span></div>
        <div class="sv-block sv-cta" data-part="cta" data-cue="2"><span class="sv-tag">04 / {labels[3]}</span><span class="sv-pill">{action} ↗</span></div>
      </div>}
      {kind === 'website' && <>
        <div class="sv-nav" data-part="nav"><span class="sv-brand">lk.</span>{labels.slice(1).map((label,i)=><span data-cue={i}>{label}</span>)}</div>
        <div class="sv-pages" data-part="sitemap">{sequence.map((item,i)=><div class="sv-page" data-cue={i}>
          <span class="sv-tag">/ {labels[i+1]}</span><strong>{item.title}</strong><p>{item.text}</p>
          {i===0 ? <div class="sv-company"><span class="sv-tile">↗</span><span><span class="sv-bar" style="--w:90%"></span><span class="sv-bar"></span><span class="sv-bar" style="--w:80%"></span></span></div> : i===1 ? <div class="sv-tiles">{details.map(d=><span class="sv-tile"><i>↗</i>{d}</span>)}</div> : <div class="sv-contact"><span class="sv-bar" style="--w:95%"></span><span class="sv-bar" style="--w:70%"></span><span class="sv-pill">{labels[3]} ↗</span></div>}
        </div>)}</div>
        <div class="sv-map">{labels.map((label,i)=><span>{i>0?'↳ ':''}{label}</span>)}</div>
      </>}
      {kind === 'webapp' && <>
        <div class="sv-nav"><span class="sv-brand">↳</span>{[labels[1],labels[2],labels[0]].map((label,i)=><span data-cue={i}>{label}</span>)}</div>
        <div class="sv-task"><span class="sv-tag">DEMO / 001</span><strong>{details[0]}</strong></div>
        <div class="sv-workflow">
          <div class="sv-task-panel" data-part="form" data-cue="0"><span class="sv-tag">01 / {sequence[0].title}</span><div class="sv-field">{details[0]}<span>✓</span></div><div class="sv-field">DEMO-001<span>✓</span></div><span class="sv-pill">+ {action}</span></div>
          <div class="sv-task-panel" data-part="table" data-cue="1"><span class="sv-tag">02 / {labels[2]}</span><div class="sv-tr"><span>DEMO-001</span><span class="sv-status">{states[0]}</span></div><div class="sv-tr"><span>{details[0]}</span><span>↗</span></div></div>
          <div class="sv-task-panel" data-part="summary" data-cue="2"><span class="sv-tag">03 / {labels[0]}</span><div class="sv-tr"><strong>DEMO-001</strong><span class="sv-status">{states[1]}</span></div><div class="sv-track">{states.map((state,i)=><span class={i<2?'sv-done':''}><i></i>{state}</span>)}</div></div>
        </div>
      </>}
      {kind === 'automation' && <div class="sv-flow" data-part="flow">{labels.map((label,i)=><>
        {i>0 && <div class="sv-link" data-part={`link-${i}`}><span class="sv-packet"></span><span>{action} ↓</span></div>}
        <div class="sv-node" data-part={`node-${i+1}`} data-cue={i}><span class="sv-node-icon">{['↧','≡','↗'][i]}</span><div><strong>{label}</strong><p>{details[i]}</p></div><span class="sv-id">001</span></div>
      </>)}</div>}
    </div>
    <div class="sv-sequence">{sequence.map((item,i)=><div data-sequence><span class="sv-tag">0{i+1} / 03</span><strong>{item.title}</strong><p>{item.text}</p></div>)}</div>
    <div class="sv-progress"><span></span></div>
  </div>
  <figcaption class="sv-caption">{visual.caption}</figcaption>
</figure>
<style is:global>
.sv { margin:0; pointer-events:none; }
.sv-frame { overflow:hidden; border:1px solid var(--color-border-strong); border-radius:1.25rem; background:var(--color-bg-elevated); box-shadow:var(--shadow-card); }
.sv-chrome { display:flex; align-items:center; gap:.75rem; padding:1rem; border-bottom:1px solid var(--color-border); }
.sv-dots { color:var(--color-border-strong); font-size:.6rem; letter-spacing:.12em; }
.sv-address { flex:1; color:var(--color-text-secondary); font: .65rem var(--font-mono); }
.sv-badge,.sv-tag { color:var(--color-text-secondary); font:.625rem var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }
.sv-badge { border:1px solid var(--color-border-strong); border-radius:99px; padding:.25rem .5rem; }
.sv-body { padding:1.25rem; font-size:.8125rem; background:radial-gradient(ellipse at 100% 0%,var(--color-accent-soft),transparent 65%); }
.sv-body strong { display:block; font-family:var(--font-display); font-size:1.125rem; font-weight:600; line-height:1.25; }
.sv-body p,.sv-sequence p { color:var(--color-text-secondary); line-height:1.5; }
.sv-caption { margin-top:1rem; color:var(--color-text-secondary); font-size:.8125rem; line-height:1.5; }
.sv-block,.sv-task-panel,.sv-page { display:grid; gap:.75rem; padding:1rem; border:1px solid var(--color-border); border-radius:.75rem; background:var(--color-bg); }
.sv-landing-page,.sv-workflow { display:grid; gap:.625rem; }
.sv-bar { display:block; width:var(--w,60%); height:.35rem; border-radius:9px; background:color-mix(in srgb,var(--color-text) 18%,transparent); }
.sv-pill { display:inline-flex; width:fit-content; padding:.6rem .9rem; border-radius:.5rem; background:var(--color-accent); color:var(--color-on-accent); font-size:.7rem; font-weight:600; }
.sv-tiles { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.5rem; }
.sv-tile { display:grid; gap:.75rem; padding:.75rem; border:1px solid var(--color-border); border-radius:.5rem; background:var(--color-bg-elevated); }
.sv-tile i { font-style:normal; color:var(--color-accent-text); }
.sv-cta { justify-items:center; background:var(--color-accent-soft); }
.sv-nav { display:flex; align-items:center; gap:1rem; font-size:.7rem; padding-bottom:1rem; }
.sv-nav [data-cue] { padding-block:.4rem; border-bottom:2px solid transparent; }
.sv-brand { margin-right:auto; font:600 1.25rem var(--font-display); color:var(--color-accent-text); }
.sv-pages { display:grid; gap:.75rem; }
.sv-page { min-height:17rem; align-content:start; gap:1.25rem; }
.sv-company { display:grid; grid-template-columns:1fr 1fr; gap:1rem; align-items:center; }
.sv-company>.sv-tile { min-height:6rem; font-size:2rem; color:var(--color-accent-text); }
.sv-company .sv-bar { margin-block:.75rem; }
.sv-contact { display:grid; gap:1rem; }
.sv-map { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.5rem; padding:1rem .25rem 0; color:var(--color-text-secondary); font:.65rem var(--font-mono); }
.sv-task { display:grid; gap:.5rem; padding:.5rem 0 1.25rem; }
.sv-field,.sv-tr { display:flex; justify-content:space-between; gap:.5rem; padding:.75rem; border:1px solid var(--color-border); border-radius:.4rem; }
.sv-status { font-size:.65rem; color:var(--color-accent-text); }
.sv-track { display:flex; justify-content:space-between; gap:.5rem; padding-block:1.5rem; font-size:.6rem; }
.sv-track span { display:grid; gap:.6rem; justify-items:center; }
.sv-track i { width:.65rem; height:.65rem; border:1px solid var(--color-border-strong); border-radius:50%; }
.sv-done i { background:var(--color-accent); }
.sv-node { display:flex; align-items:center; gap:.75rem; padding:1.25rem .9rem; border:1px solid var(--color-border-strong); border-radius:.75rem; background:var(--color-bg); }
.sv-node strong { font-size:.9rem; }
.sv-node p { margin-top:.3rem; font-size:.75rem; }
.sv-node-icon { display:grid; place-items:center; flex:none; width:2rem; height:2.5rem; color:var(--color-accent-text); font-size:1.5rem; }
.sv-id { margin-left:auto; color:var(--color-accent-text); font:.65rem var(--font-mono); }
.sv-link { position:relative; height:3rem; margin-left:1.9rem; border-left:2px solid var(--color-border-strong); padding:.9rem 1rem; color:var(--color-text-secondary); font:.625rem var(--font-mono); }
.sv-packet { position:absolute; left:-4px; top:0; height:.6rem; width:6px; border-radius:3px; background:var(--color-accent); }
.sv-sequence { display:grid; gap:.75rem; padding:1rem 1.25rem; border-top:1px solid var(--color-border); }
.sv-sequence strong { display:block; margin:.4rem 0; font-size:.875rem; }
.sv-sequence p { font-size:.75rem; }
.sv-progress { height:2px; background:var(--color-border); }
.sv-progress>span { display:block; height:100%; transform:scaleX(var(--story-progress,1)); transform-origin:left; background:var(--color-accent); }
@media(prefers-reduced-motion:no-preference) {
 .sv-animated .sv-sequence { min-height:8.5rem; }
 .sv-animated .sv-sequence>div { display:none; }
 .sv-animated .sv-sequence>.is-current { display:block; }
 .sv-animated .sv-pages,.sv-animated .sv-workflow { display:grid; }
 .sv-animated .sv-page,.sv-animated .sv-task-panel { grid-area:1/1; opacity:0; visibility:hidden; transform:translateY(8px); transition:opacity 200ms,transform 300ms; }
 .sv-animated .sv-task-panel { min-height:17rem; align-content:start; }
 .sv-animated .is-cued { opacity:1; visibility:visible; transform:none; border-color:var(--color-accent-text); }
 .sv-animated .sv-block,.sv-animated .sv-node { transition:border-color 200ms,transform 300ms; }
 .sv-animated .sv-cta.is-cued .sv-pill { transform:scale(1.06); }
 .sv-animated .sv-nav .is-cued { color:var(--color-accent-text); }
 .sv-animated .sv-packet { transform:translateY(calc(clamp(0,var(--story-progress,0)*3 - 1,1)*38px)); }
 .sv-animated .sv-link:nth-child(4) .sv-packet { transform:translateY(calc(clamp(0,var(--story-progress,0)*3 - 2,1)*38px)); }
}
@media(max-width:639px) {
 .sv-body { padding:1rem; }
 .sv-block { padding:.75rem; gap:.5rem; }
 .sv-body strong { font-size:1rem; }
 .sv-nav { gap:.75rem; }
 .sv-animated .sv-task-panel,.sv-page { min-height:15rem; }
}
</style>
