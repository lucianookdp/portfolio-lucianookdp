---
import SectionHeading from '../ui/SectionHeading.astro';
import RevealText from '../ui/RevealText.astro';
import ServiceVisual from './ServiceVisual.astro';
import type { Dictionary } from '../../i18n/utils';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const { labels, offerings } = dict.services;

// Small line icons for the chooser cards, keyed by offering kind.
const KIND_ICONS: Record<string, string> = {
  landing: `<rect x="3" y="4" width="26" height="24" rx="3" /><path d="M3 10h26M7 7h.1M10 7h.1M8 15h10M8 19h6" /><path d="m21 17 6 6-3 .5-1 3Z" fill="currentColor" stroke-width="1" />`,
  website: `<rect x="3" y="4" width="26" height="24" rx="3" /><path d="M3 10h26M7 7h.1M10 7h.1M8 15h16M8 19h6M8 23h6M19 19h5M19 23h5" />`,
  webapp: `<rect x="3" y="4" width="26" height="24" rx="3" /><path d="M3 10h26M7 7h.1M10 7h.1M11 10v18M6 15h2M6 19h2M16 23v-4M21 23v-8M26 23v-6" />`,
  automation: `<rect x="12" y="12" width="8" height="8" rx="2" /><circle cx="6" cy="6" r="3" /><circle cx="26" cy="6" r="3" /><circle cx="6" cy="26" r="3" /><circle cx="26" cy="26" r="3" /><path d="m8 8 5 5m6 0 5-5M8 24l5-5m6 0 5 5" />`
};
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<section id="services" class="container-site scroll-mt-24 py-16 sm:py-24 lg:py-32">
  <SectionHeading index={dict.services.index} heading={dict.services.heading} subheading={dict.services.subheading} />

  <div class="mt-8 max-w-3xl sm:mt-10">
    <RevealText as="p" class="font-display text-xl font-medium leading-snug tracking-tight sm:text-2xl lg:text-3xl">
      {dict.services.intro}
    </RevealText>
  </div>

  <!-- Chooser: one card per need, each jumping to its full service block. -->
  <nav class="service-chooser mt-10 sm:mt-14" aria-labelledby="service-chooser-heading">
    <h3 id="service-chooser-heading" class="eyebrow" data-reveal>{dict.services.chooserHeading}</h3>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
      {offerings.map((offering, index) => (
        <li class="offering-reveal" data-reveal data-reveal-delay={index * 70}>
          <a href={`#${offering.id}`} class="offering spot-card">
            <span class="offering-accent" aria-hidden="true"></span>
            <span class="offering-head">
              <span class="offering-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={KIND_ICONS[offering.kind]} />
              </span>
              <span class="font-mono text-[11px] text-[var(--color-text-secondary)]" aria-hidden="true">{number(index)}</span>
            </span>
            <span class="offering-need">“{offering.need}”</span>
            <span class="offering-title font-display font-semibold">{offering.title}</span>
            <span class="offering-more">
              {dict.services.chooserMore}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="m6 13 6 6 6-6" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-5 font-sans text-sm text-[var(--color-text-secondary)]" data-reveal>
      {dict.services.chooserHelp}
      <a href="#contact" class="ml-1 font-medium text-[var(--color-accent-text)] underline underline-offset-4">{dict.services.chooserHelpLink}</a>
    </p>
  </nav>

  <!-- Full service blocks. Copy on one side, an illustrative visual on the
       other; data-service / data-service-visual are the hooks for the
       stage 2 3D models and animations. -->
  <div class="service-story" data-service-story data-label={dict.services.storyLabel}>
  <div class="service-list">
    {offerings.map((offering, index) => (
      <article id={offering.id} class="service-block scroll-mt-24" data-service={offering.kind} aria-labelledby={`${offering.id}-title`}>
        <div class="service-copy">
          <p class="service-eyebrow" data-reveal>
            <span class="service-number">{labels.service} {number(index)}</span>
            <span>{offering.kicker}</span>
          </p>
          <h3 id={`${offering.id}-title`} class="service-title font-display font-semibold" data-reveal>{offering.title}</h3>

          <p class="service-lead" data-reveal>{offering.what}</p>

          <div class="service-lists" data-reveal>
            <div>
              <p class="service-label">{labels.when}</p>
              <ul class="service-bullets">
                {offering.when.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <p class="service-label">{labels.includes}</p>
              <ul class="service-bullets service-bullets-check">
                {offering.includes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>

          <div class="service-practice" data-reveal>
            <p class="service-label">{labels.practice}</p>
            <p>{offering.practice}</p>
          </div>

          <div class="service-next" data-reveal>
            <div>
              <p class="service-label">{labels.next}</p>
              <p class="service-next-text">{offering.nextStep}</p>
            </div>
            <a href="#contact" class="btn btn-primary btn-sm service-cta" data-magnetic="0.2">
              {offering.cta}
              <svg class="btn-arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
            </a>
          </div>
        </div>

        <div class="service-visual-col">
          <ServiceVisual kind={offering.kind} visual={offering.visual} site={dict.services.site} />
        </div>
      </article>
    ))}
  </div>
  </div>
</section>

<script>
  import { initServiceStory } from '../../lib/service-story';
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => { cleanup?.(); cleanup = initServiceStory(); });
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>

<!-- Global styles: every class here is service- and offering-prefixed, and skipping Astro's
     per-selector scope attribute keeps the page CSS within budget. -->
<style is:global>
  /* Chooser cards keep the .offering hooks used by the touch scroll glow in
     lib/interactions.ts. */
  .offering {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 1.25rem;
    background: var(--color-bg);
    color: var(--color-text);
    transition: border-color 300ms ease, box-shadow 300ms ease;
  }
  html:not(.dark) .offering { background: var(--color-bg-elevated); box-shadow: var(--shadow-card); }
  .offering > * { position: relative; z-index: 1; }
  .offering > .offering-accent { position: absolute; top: -1px; left: 1.25rem; right: 1.25rem; height: 1px; z-index: 2; pointer-events: none; background: linear-gradient(90deg, transparent, var(--color-accent-glow), transparent); opacity: 0.55; }
  .offering:focus-visible { outline: 2px solid var(--color-accent-text); outline-offset: 3px; border-radius: 1.25rem; }
  .offering-head { display: flex; align-items: center; justify-content: space-between; }
  .offering-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 0.75rem; background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg-elevated)); color: var(--color-accent-text); }
  .offering-icon svg { width: 1.625rem; height: 1.625rem; }
  .offering-need { margin-top: 1.25rem; color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.55; }
  .offering-title { margin-top: auto; padding-top: 1.25rem; font-size: 1.125rem; line-height: 1.3; }
  .offering-more { display: inline-flex; align-items: center; gap: 0.375rem; margin-top: 0.5rem; color: var(--color-accent-text); font-size: 0.8125rem; font-weight: 500; }
  .offering-more svg { width: 0.875rem; height: 0.875rem; transition: transform 300ms var(--ease-out-expo); }
  @media (min-width: 640px) { .offering { padding: 1.5rem; } }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .offering:hover { border-color: var(--color-accent); box-shadow: 0 16px 36px -28px var(--color-accent-glow); }
    .offering:hover .offering-more svg { transform: translateY(3px); }
  }
  @media (hover: none) and (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    .offering::before, .offering::after { opacity: var(--mobile-glow, 0); }
    .offering:active::before, .offering:active::after { opacity: 1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .offering-reveal.is-revealed .offering-icon svg { animation: offering-icon-draw 900ms var(--ease-out-expo) both; animation-delay: calc(var(--reveal-delay, 0ms) + 150ms); }
    .offering-reveal.is-revealed .offering-accent { animation: service-accent-enter 1s var(--ease-out-expo) both; animation-delay: var(--reveal-delay, 0ms); }
  }
  @keyframes offering-icon-draw { from { stroke-dasharray: 120; stroke-dashoffset: 120; } to { stroke-dasharray: 120; stroke-dashoffset: 0; } }
  @keyframes service-accent-enter { from { opacity: 0; transform: scaleX(0.15); } to { opacity: 0.55; transform: scaleX(1); } }

  /* Service blocks */
  /* Each service is its own card, so the four offers read as separate blocks. */
  .service-list { display: grid; gap: 1.5rem; margin-top: 3rem; }
  .service-block { display: grid; gap: 2rem; padding: 1.5rem 1.25rem; border: 1px solid var(--color-border-strong); border-radius: 1.5rem; background: var(--color-bg-elevated); }
  html:not(.dark) .service-block { box-shadow: var(--shadow-card); }
  .service-copy { min-width: 0; }
  .service-title { margin-top: 0.875rem; font-size: clamp(1.875rem, 3.8vw, 2.75rem); line-height: 1.08; letter-spacing: -0.03em; }
  /* Number pill and kicker wrap as whole pieces, so they never split mid-label. */
  .service-eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; color: var(--color-text-secondary); font-size: 0.875rem; }
  .service-number { padding: 0.25rem 0.625rem; border-radius: 999px; background: var(--color-accent-soft); color: var(--color-accent-text); font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .service-label { margin-bottom: 0.5rem; color: var(--color-text); font-size: 0.9375rem; font-weight: 600; line-height: 1.4; }
  .service-lead { max-width: 60ch; margin-top: 1rem; color: var(--color-text-secondary); font-size: 1.0625rem; line-height: 1.65; }
  /* Thin rules split the card into: summary, lists, practice, next step. */
  .service-lists, .service-practice { margin-top: 1.75rem; padding-top: 1.75rem; border-top: 1px solid var(--color-border); }
  .service-lists { display: grid; gap: 1.75rem; }
  .service-bullets { display: grid; gap: 0.625rem; color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.55; }
  .service-bullets li { position: relative; padding-left: 1.25rem; }
  .service-bullets li::before { content: ''; position: absolute; left: 0.125rem; top: 0.6em; width: 0.375rem; height: 0.375rem; border-radius: 999px; background: var(--color-accent-text); }
  .service-bullets-check li::before { top: 0.35em; width: 0.75rem; height: 0.75rem; left: 0; border-radius: 0; background: none; border: solid var(--color-accent-text); border-width: 0 2px 2px 0; transform: translateX(0.2rem) rotate(45deg) scale(0.55, 0.8); }
  .service-practice { color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.65; }
  .service-practice > p:last-child { max-width: 62ch; }
  .service-next { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; margin-top: 1.75rem; padding: 1.25rem; border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border)); border-radius: 1rem; background: color-mix(in srgb, var(--color-accent) 7%, var(--color-bg)); }
  .service-next-text { font-size: 0.9375rem; line-height: 1.55; }
  .service-cta { white-space: normal; text-align: left; line-height: 1.25; }
  .service-visual-col { min-width: 0; }

  @media (min-width: 640px) {
    .service-lists { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
    .service-next { padding: 1.5rem; }
    .service-block { padding: 2rem; }
  }
  @media (min-width: 1024px) {
    .service-list { gap: 2rem; margin-top: 4rem; }
    .service-block { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: start; gap: 3rem; padding: 2.5rem; }

    /* The visual stays in view while the longer copy scrolls past it. */
    .service-visual-col { position: sticky; top: 6.5rem; }
  }

  .service-stage { display: none; }
  html:not(.js) .service-visual-col { position:static; }
  @media(prefers-reduced-motion:reduce) { .service-visual-col { position:static; } }
  @media (min-width:1024px) and (min-height:800px) {
    .service-story.is-connected { display: grid; grid-template-columns: 1.05fr 1fr; gap: 4rem; align-items: start; margin-top: 3rem; }
    .is-connected .service-list { display: grid; gap: 2rem; margin-top: 0; }
    .is-connected .service-block { display: block; padding: 2.5rem; }
    .is-connected .service-stage { display: grid; position: sticky; top: 6.5rem; padding-top: 2rem; }
    .service-stage .service-visual-col { grid-area: 1 / 1; position: relative; top: auto; opacity: 0; visibility: hidden; transform: translateY(12px) scale(.98); transition: opacity 250ms, transform 350ms, visibility 250ms; pointer-events: none; }
    .service-stage .service-visual-col.is-current { opacity: 1; visibility: visible; transform: none; }
    .service-stage .sv-sequence { min-height:6.5rem; }
  }
</style>
