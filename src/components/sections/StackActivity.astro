---
import SectionHeading from '../ui/SectionHeading.astro';
import stackData from '../../data/stack.json';
import rawStats from '../../data/github-stats.json';
import type { GithubStats } from '../../lib/github-stats';
import type { Dictionary, Locale } from '../../i18n/utils';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const stats = rawStats as GithubStats;
const hasData = stats.generatedAt !== null;
const numberFormatter = new Intl.NumberFormat(locale === 'pt' ? 'pt-BR' : 'en-US');

const groups = [
  { key: 'languages', items: stackData.languages },
  { key: 'frontend', items: stackData.frontend },
  { key: 'backend', items: stackData.backend },
  { key: 'databases', items: stackData.databases },
  { key: 'tools', items: stackData.tools }
] as const;

const statCards = [
  { label: dict.github.contributions, value: stats.totalContributions },
  { label: dict.github.repos, value: stats.totalRepos },
  { label: dict.github.stars, value: stats.totalStars }
];
const recentWeeks = stats.weeks.slice(-20);
---

<section id="stack" class="container-site scroll-mt-24 py-10 sm:py-14 lg:py-16">
  <SectionHeading index={dict.stack.index} heading={dict.stack.heading} subheading={dict.stack.subheading} compact />

  <div class="mt-6 flex flex-col gap-3">
    {hasData && (
      <div class="card spot-card flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:p-5" data-reveal>
        <div class="flex items-center gap-6 sm:gap-10">
          {statCards.map((card) => (
            <div class="min-w-0">
              <p class="stat-number font-display text-2xl font-semibold leading-none tracking-tight sm:text-3xl" data-count-to={card.value}>
                {numberFormatter.format(card.value)}
              </p>
              <p class="mt-1 max-w-[7rem] font-sans text-[10px] leading-tight text-[var(--color-text-secondary)] sm:text-[11px]">{card.label}</p>
            </div>
          ))}
        </div>
        <div class="flex min-w-0 flex-col gap-2 sm:items-end">
          <div
            role="img"
            aria-label={`${dict.github.heatmapCaption}: ${numberFormatter.format(stats.totalContributions)} ${dict.github.contributions}`}
            class="heatmap grid w-fit max-w-full grid-flow-col gap-[3px] overflow-x-auto"
            data-lenis-prevent
          >
            {recentWeeks.map((week) => (
              <div class="grid grid-rows-7 gap-[3px]">
                {week.map((day) => (
                  <div
                    class="heatmap-cell h-[9px] w-[9px] rounded-[2px] sm:h-[10px] sm:w-[10px]"
                    style={`background-color: color-mix(in srgb, var(--color-accent) ${day.level === 0 ? 0 : day.level * 22 + 12}%, var(--color-bg-subtle))`}
                    title={`${day.date}: ${day.count}`}
                  ></div>
                ))}
              </div>
            ))}
          </div>
          <a href={`https://github.com/${stats.login}`} target="_blank" rel="noopener noreferrer" class="font-mono text-[10px] text-[var(--color-text-secondary)] underline-offset-4 hover:text-[var(--color-text)] hover:underline">
            {dict.github.viewProfile} ↗
          </a>
        </div>
      </div>
    )}

    <div class="card p-4 sm:p-5" data-reveal data-reveal-delay="100">
      <dl class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-5">
        {groups.map((group, index) => (
          <div class="min-w-0" data-reveal data-reveal-delay={index * 50}>
            <dt class="eyebrow">{dict.stack.categories[group.key]}</dt>
            <dd class="mt-1.5 flex flex-wrap gap-1">
              {group.items.map((item) => (
                <span class="tech-chip">{item}</span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'motion';

  function init() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const formatter = new Intl.NumberFormat(document.documentElement.lang.startsWith('pt') ? 'pt-BR' : 'en-US');

    const numbers = document.querySelectorAll<HTMLElement>('.stat-number[data-count-to]:not([data-init])');
    numbers.forEach((el) => (el.dataset.init = 'true'));
    if (numbers.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            animate(0, Number(el.dataset.countTo), {
              duration: 1.4,
              ease: [0.16, 1, 0.3, 1],
              onUpdate(latest) {
                el.textContent = formatter.format(Math.round(latest));
              }
            });
            observer.unobserve(el);
          });
        },
        { threshold: 0.4 }
      );
      numbers.forEach((el) => observer.observe(el));
    }

    const heatmap = document.querySelector<HTMLElement>('.heatmap:not([data-init])');
    if (heatmap) {
      heatmap.dataset.init = 'true';
      const cells = heatmap.querySelectorAll('.heatmap-cell');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            animate(cells, { opacity: [0, 1], transform: ['scale(0.6)', 'scale(1)'] }, { duration: 0.4, delay: stagger(0.004) });
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.2 }
      );
      observer.observe(heatmap);
    }

    // Chips shimmer in one after another the first time they appear.
    const chips = document.querySelectorAll<HTMLElement>('.tech-chip:not([data-init])');
    if (chips.length > 0) {
      chips.forEach((el) => (el.dataset.init = 'true'));
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          animate(chips, { opacity: [0, 1], transform: ['translateY(6px)', 'translateY(0)'] }, { duration: 0.5, delay: stagger(0.03) });
          observer.disconnect();
        },
        { threshold: 0.2 }
      );
      observer.observe(chips[0].closest('.card') ?? chips[0]);
    }
  }

  document.addEventListener('astro:page-load', init);
</script>
