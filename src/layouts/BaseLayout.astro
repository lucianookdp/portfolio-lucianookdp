---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import { getDictionary, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  ptPath?: string;
  enPath?: string;
  noIndex?: boolean;
}

const { locale, title, description, ptPath = '/', enPath = '/en', noIndex = false } = Astro.props;
const dict = getDictionary(locale);

const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(locale === 'en' ? '/og-en.png' : '/og.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${Astro.site}#person`,
      name: 'Luciano K. Dal Pai',
      url: String(Astro.site),
      jobTitle: 'Full-Stack Software Engineer',
      knowsLanguage: ['pt-BR', 'en'],
      sameAs: ['https://github.com/lucianookdp', 'https://www.linkedin.com/in/lucianookdp/']
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: String(Astro.site),
      name: 'Luciano K. Dal Pai',
      description: pageDescription,
      inLanguage: locale === 'pt' ? 'pt-BR' : 'en',
      author: { '@id': `${Astro.site}#person` }
    }
  ]
};
---

<!doctype html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="google-site-verification" content="8sgfW2OFAdFr3pEkx6YtgTbVwmFRgC6oZ6CNWm2urm8" />
    <meta name="theme-color" content="#08090c" />
    <meta name="apple-mobile-web-app-title" content="Luciano K. Dal Pai" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(ptPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(ptPath, Astro.site)} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'pt' ? 'en_US' : 'pt_BR'} />
    <meta property="og:site_name" content="Luciano K. Dal Pai" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <ClientRouter />

    <script is:inline>
      // Astro's ClientRouter can leave an unhandled rejection on its internal
      // transition.finished promise when the browser aborts a view transition
      // (e.g. InvalidStateError if the document isn't visible at the moment of
      // navigation) — the page navigation itself still completes correctly.
      // Silence only that exact, known-benign case so real errors still surface.
      window.addEventListener('unhandledrejection', function (event) {
        var reason = event.reason;
        if (reason && reason.name === 'InvalidStateError' && /transition/i.test(reason.message || '')) {
          event.preventDefault();
        }
      });
    </script>

    {!noIndex && <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />}

    <script is:inline>
      // Always start at the top on a fresh load or reload (browsers would
      // otherwise restore the previous scroll position). Links to a #section
      // still land on that section.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!location.hash) {
        // Astro's ClientRouter keeps the last scroll position in history.state
        // and restores it on load, so zero that too before it initialises.
        try {
          if (history.state && (history.state.scrollY || history.state.scrollX)) {
            history.replaceState(Object.assign({}, history.state, { scrollX: 0, scrollY: 0 }), '');
          }
        } catch (e) {}
        window.scrollTo(0, 0);
        var toTop = function () {
          window.scrollTo(0, 0);
          requestAnimationFrame(function () {
            window.scrollTo(0, 0);
          });
        };
        window.addEventListener('pageshow', toTop);
        window.addEventListener('load', toTop);
      }

      // Language: honour an explicit choice (stored by the toggle); otherwise a
      // first visit to the root from a non-Portuguese browser goes to /en.
      (function () {
        try {
          // GitHub Pages serves /en as /en/, so both spellings count.
          var path = location.pathname;
          var onEn = path === '/en' || path === '/en/';
          var pref = localStorage.getItem('lang');
          if (pref === 'en' && path === '/') location.replace('/en' + location.search + location.hash);
          else if (pref === 'pt' && onEn) location.replace('/' + location.search + location.hash);
          else if (!pref && path === '/' && !onEn && !/^pt/i.test(navigator.language || '')) location.replace('/en' + location.search + location.hash);
        } catch (e) {}
      })();

      function applyStoredTheme() {
        document.documentElement.classList.add('js');
        // Dark is the default; only an explicit choice on the toggle changes it.
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme = stored === 'light' ? 'light' : 'dark';
        document.documentElement.classList.toggle('dark', theme === 'dark');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#08090c' : '#edf0f4');
      }
      applyStoredTheme();
      document.addEventListener('astro:after-swap', applyStoredTheme);
    </script>

    <!-- Cloudflare Web Analytics: cookie-less pageview/visitor counts, no backend. -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "92371cc8e4dc493cb5dd964a99142255"}'
      is:inline
    ></script>
  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>

    <SkipLink label={dict.nav.skipToContent} />
    <Header dict={dict} locale={locale} ptPath={ptPath} enPath={enPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer dict={dict} locale={locale} />

    <script>
      import { initLenis, destroyLenis } from '../lib/lenis';
      import { initInteractions, destroyInteractions } from '../lib/interactions';

      function onPageLoad() {
        initLenis();
        initInteractions();
      }

      // astro:page-load fires on the initial load as well as after every
      // client-side navigation, so one listener covers both.
      document.addEventListener('astro:page-load', onPageLoad);
      document.addEventListener('astro:before-swap', () => {
        destroyLenis();
        destroyInteractions();
      });

      console.log('%cLuciano K. Dal Pai', 'font-family:system-ui;font-size:20px;font-weight:700;color:#22b573;');
      console.log('%cconstruído com Astro, TypeScript, Three.js e Motion.', 'font-size:12px;color:#8b919f;');
      console.log('%cse chegou até aqui, provavelmente também abre o console por hábito: engslucianok@gmail.com', 'font-size:12px;color:#8b919f;');
    </script>
  </body>
</html>
