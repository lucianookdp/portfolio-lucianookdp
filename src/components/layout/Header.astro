---
import LanguageToggle from '../islands/LanguageToggle.tsx';
import ThemeToggle from '../islands/ThemeToggle.tsx';
import CommandPalette from '../islands/CommandPalette.tsx';
import type { Dictionary, Locale } from '../../i18n/utils';

interface Props {
  dict: Dictionary;
  locale: Locale;
  ptPath: string;
  enPath: string;
}

const { dict, locale, ptPath, enPath } = Astro.props;

const navItems = [
  { href: '#about', id: 'about', label: dict.nav.about },
  { href: '#projects', id: 'projects', label: dict.nav.projects },
  { href: '#services', id: 'services', label: dict.nav.services },
  { href: '#contact', id: 'contact', label: dict.nav.contact },
  { href: '#stack', id: 'stack', label: dict.nav.stack }
];

const homePath = locale === 'pt' ? '/' : '/en';
const INFINITY_PATH =
  'M 25 10 C 10 10 10 40 25 40 C 35 40 40 30 50 25 C 60 20 65 10 75 10 C 90 10 90 40 75 40 C 65 40 60 30 50 25 C 40 20 35 10 25 10 Z';
---

<header class="site-header" id="site-header">
  <div class="site-header-inner flex items-center justify-between px-4 py-2 sm:px-5">
    <a
      href={homePath}
      class="inline-flex items-center whitespace-nowrap font-sans text-lg font-semibold tracking-tight"
      transition:name="site-logo"
      aria-label="lucianookdp"
    >
      <span aria-hidden="true">lucian</span>
      <svg aria-hidden="true" viewBox="4 4 92 42" class="mx-[-0.015em] h-[0.62em] w-auto translate-y-[0.02em]">
        <defs>
          <linearGradient id="header-infinity-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--color-accent-glow)" />
            <stop offset="100%" stop-color="var(--color-accent)" />
          </linearGradient>
        </defs>
        <path d={INFINITY_PATH} fill="none" stroke="url(#header-infinity-grad)" stroke-width="11" stroke-linecap="round" />
      </svg>
      <span aria-hidden="true">kdp</span>
    </a>

    <nav aria-label={dict.nav.primary} class="relative hidden items-center gap-1 font-sans text-sm text-[var(--color-text-secondary)] md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          class="relative rounded-full px-3 py-1.5 transition-colors duration-200 hover:text-[var(--color-text)] aria-[current]:text-[var(--color-text)]"
        >
          {item.label}
        </a>
      ))}
      <span id="nav-indicator" aria-hidden="true"></span>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="open-command-palette"
        aria-label={dict.commandPalette.openButton}
        class="tap-scale hidden h-9 select-none items-center gap-1.5 rounded-full border border-[var(--color-border-strong)] px-3 font-mono text-xs text-[var(--color-text-secondary)] transition-colors duration-200 hover:border-[var(--color-accent)] hover:text-[var(--color-text)] sm:flex"
      >
        <span>&#8984;K</span>
      </button>
      <LanguageToggle client:load currentLocale={locale} ptPath={ptPath} enPath={enPath} />
      <ThemeToggle client:load labelLight={dict.commandPalette.toggleThemeLight} labelDark={dict.commandPalette.toggleThemeDark} />
      <button
        type="button"
        id="menu-toggle"
        class="burger tap-scale text-[var(--color-text)] md:hidden"
        aria-label={dict.nav.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
      </button>
      <CommandPalette client:load dict={dict.commandPalette} navItems={navItems} currentLocale={locale} ptPath={ptPath} enPath={enPath} />
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="aurora" aria-hidden="true"><span class="aurora-blob"></span></div>
  <div class="relative flex h-full flex-col justify-between pt-24">
    <p class="eyebrow">{dict.nav.menuHint}</p>
    <nav aria-label={dict.nav.primary} class="flex flex-col gap-2">
      {navItems.map((item, index) => (
        <a href={item.href} data-menu-link class="menu-link flex items-baseline gap-4" style={`transition-delay: ${120 + index * 60}ms`}>
          <span class="font-mono text-xs text-[var(--color-accent-text)]">0{index + 1}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
    <div class="flex items-center justify-between border-t border-[var(--color-border)] pt-6 font-mono text-xs text-[var(--color-text-secondary)]">
      <span>{dict.hero.location}</span>
      <a href="https://github.com/lucianookdp" target="_blank" rel="noopener noreferrer me" class="hover:text-[var(--color-text)]">GitHub ↗</a>
    </div>
  </div>
</div>

<script>
  import { animate } from 'motion';
  import { lockScroll, unlockScroll, scrollToTarget } from '../../lib/lenis';

  // Header rewires itself on every Astro page-transition (PT/EN switch etc.),
  // since the transition swaps in fresh nav/button elements. Everything that
  // attaches to document/window is torn down first, otherwise repeated
  // navigations would stack up duplicate listeners.
  let teardownHeader: (() => void) | null = null;

  function initHeader() {
    teardownHeader?.();
    const cleanups: Array<() => void> = [];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Floating header: compact + glass after a little scroll, hides on the way
       down and returns on the way up. */
    const header = document.getElementById('site-header');
    let lastY = window.scrollY;
    let ticking = false;
    function updateHeader() {
      const y = window.scrollY;
      if (header) {
        header.classList.toggle('is-scrolled', y > 24);
        const goingDown = y > lastY + 4;
        const goingUp = y < lastY - 4;
        if (goingDown && y > 420) header.classList.add('is-hidden');
        else if (goingUp || y < 120) header.classList.remove('is-hidden');
      }
      lastY = y;
      ticking = false;
    }
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    updateHeader();
    cleanups.push(() => window.removeEventListener('scroll', onScroll));

    /* Command palette trigger + first-visit hint */
    const cmdkButton = document.getElementById('open-command-palette');
    function onCmdkClick() {
      window.dispatchEvent(new CustomEvent('command-palette:open'));
    }
    cmdkButton?.addEventListener('click', onCmdkClick);
    if (cmdkButton) cleanups.push(() => cmdkButton.removeEventListener('click', onCmdkClick));

    if (cmdkButton && !localStorage.getItem('cmdk-hint-seen')) {
      const showHint = () => cmdkButton.classList.add('cmdk-hint');
      const dismissHint = () => {
        cmdkButton.classList.remove('cmdk-hint');
        localStorage.setItem('cmdk-hint-seen', '1');
        window.removeEventListener('command-palette:open', dismissHint);
        cmdkButton.removeEventListener('click', dismissHint);
        document.removeEventListener('keydown', onKeydownDismiss);
      };
      function onKeydownDismiss(event: KeyboardEvent) {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') dismissHint();
      }
      const hintTimer = window.setTimeout(showHint, 2500);
      window.addEventListener('command-palette:open', dismissHint);
      cmdkButton.addEventListener('click', dismissHint);
      document.addEventListener('keydown', onKeydownDismiss);
      cleanups.push(() => {
        window.clearTimeout(hintTimer);
        window.removeEventListener('command-palette:open', dismissHint);
        cmdkButton.removeEventListener('click', dismissHint);
        document.removeEventListener('keydown', onKeydownDismiss);
      });
    }

    /* Active section indicator */
    const navEl = header?.querySelector<HTMLElement>('nav[aria-label]') ?? null;
    const indicator = document.getElementById('nav-indicator');
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    const sections = navLinks
      .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href') ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    function setActive(index: number, animated: boolean) {
      navLinks.forEach((link, i) => {
        if (i === index) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      const activeLink = navLinks[index];
      if (!indicator || !navEl || !activeLink) return;
      const x = activeLink.offsetLeft + 12;
      const width = Math.max(0, activeLink.offsetWidth - 24);
      if (animated && !prefersReducedMotion) {
        animate(indicator, { transform: `translateX(${x}px)`, width: `${width}px` }, { duration: 0.45, ease: [0.16, 1, 0.3, 1] });
      } else {
        indicator.style.transform = `translateX(${x}px)`;
        indicator.style.width = `${width}px`;
      }
    }

    if (sections.length === navLinks.length && sections.length > 0) {
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const index = sections.indexOf(entry.target as HTMLElement);
            if (index !== -1) setActive(index, true);
          });
        },
        { rootMargin: '-40% 0px -50% 0px', threshold: 0 }
      );
      sections.forEach((section) => sectionObserver.observe(section));
      function onResize() {
        const current = navLinks.findIndex((link) => link.hasAttribute('aria-current'));
        if (current !== -1) setActive(current, false);
      }
      window.addEventListener('resize', onResize);
      cleanups.push(() => {
        sectionObserver.disconnect();
        window.removeEventListener('resize', onResize);
      });
    }

    /* Mobile menu */
    const menuToggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const openLabel = menuToggle?.getAttribute('aria-label') ?? '';
    let menuOpen = false;

    function setMenu(open: boolean) {
      if (!menu || !menuToggle) return;
      menuOpen = open;
      menu.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? menuToggle.dataset.closeLabel ?? openLabel : openLabel);
      if (open) lockScroll();
      else unlockScroll();
    }
    function onMenuToggle() {
      setMenu(!menuOpen);
    }
    function onMenuLinkClick(event: Event) {
      const link = event.currentTarget as HTMLAnchorElement;
      const href = link.getAttribute('href') ?? '';
      if (!href.startsWith('#')) return;
      event.preventDefault();
      setMenu(false);
      window.setTimeout(() => scrollToTarget(href), 250);
    }
    function onMenuKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape' && menuOpen) setMenu(false);
    }
    menuToggle?.addEventListener('click', onMenuToggle);
    document.addEventListener('keydown', onMenuKeydown);
    const menuLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]'));
    menuLinks.forEach((link) => link.addEventListener('click', onMenuLinkClick));
    cleanups.push(() => {
      if (menuOpen) setMenu(false);
      menuToggle?.removeEventListener('click', onMenuToggle);
      document.removeEventListener('keydown', onMenuKeydown);
      menuLinks.forEach((link) => link.removeEventListener('click', onMenuLinkClick));
    });

    /* Keyboard chords: g then a/p/v/g/s/c */
    const sectionShortcuts: Record<string, string> = { a: 'about', p: 'projects', v: 'services', s: 'stack', c: 'contact' };
    let awaitingChord = false;
    let chordTimeoutId = 0;
    function onShortcutKeydown(event: KeyboardEvent) {
      const target = event.target as HTMLElement | null;
      const isTyping = !!target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
      if (isTyping || event.metaKey || event.ctrlKey || event.altKey) return;
      if (!awaitingChord) {
        if (event.key.toLowerCase() === 'g') {
          awaitingChord = true;
          window.clearTimeout(chordTimeoutId);
          chordTimeoutId = window.setTimeout(() => {
            awaitingChord = false;
          }, 900);
        }
        return;
      }
      awaitingChord = false;
      window.clearTimeout(chordTimeoutId);
      const targetId = sectionShortcuts[event.key.toLowerCase()];
      if (targetId) scrollToTarget(`#${targetId}`);
    }
    document.addEventListener('keydown', onShortcutKeydown);
    cleanups.push(() => {
      window.clearTimeout(chordTimeoutId);
      document.removeEventListener('keydown', onShortcutKeydown);
    });

    teardownHeader = () => cleanups.forEach((fn) => fn());
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
