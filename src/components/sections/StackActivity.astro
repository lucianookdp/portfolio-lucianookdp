---
import SectionHeading from '../ui/SectionHeading.astro';
import stackData from '../../data/stack.json';
import rawStats from '../../data/github-stats.json';
import type { GithubStats } from '../../lib/github-stats';
import type { Dictionary, Locale } from '../../i18n/utils';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const stats = rawStats as GithubStats;
const hasData = stats.generatedAt !== null;
const numberFormatter = new Intl.NumberFormat(locale === 'pt' ? 'pt-BR' : 'en-US');

const groups = [
  { key: 'languages', items: stackData.languages },
  { key: 'frontend', items: stackData.frontend },
  { key: 'backend', items: stackData.backend },
  { key: 'databases', items: stackData.databases },
  { key: 'tools', items: stackData.tools }
] as const;

const statCards = [
  { label: dict.github.contributions, value: stats.totalContributions },
  { label: dict.github.repos, value: stats.totalRepos }
];
const recentWeeks = stats.weeks.slice(-52);
---

<section id="stack" class="container-site scroll-mt-24 py-10 sm:py-14 lg:py-16">
  <SectionHeading index={dict.stack.index} heading={dict.stack.heading} subheading={dict.stack.subheading} compact />

  <div class="card mt-6 overflow-hidden p-5 sm:p-6" data-reveal>
    {hasData && (
      <div class="grid gap-5 pb-5 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8">
        <div class="grid grid-cols-2 gap-4 sm:flex sm:gap-10">
          {statCards.map((card) => (
            <div class="min-w-0">
              <p class="stat-number font-display text-xl font-medium leading-none tracking-tight sm:text-2xl" data-count-to={card.value}>
                {numberFormatter.format(card.value)}
              </p>
              <p class="mt-1 max-w-[7rem] font-sans text-xs leading-snug text-[var(--color-text-secondary)]">{card.label}</p>
            </div>
          ))}
        </div>
        <div class="flex min-w-0 max-w-full flex-col items-start gap-2 sm:items-end">
          <div
            role="img"
            aria-label={dict.github.heatmapCaption}
            class="heatmap grid w-fit max-w-full grid-flow-col gap-[3px] overflow-x-auto"
            data-lenis-prevent
          >
            {recentWeeks.map((week) => (
              <div class="heat-col grid grid-rows-7 gap-[3px]">
                {week.map((day) => (
                  <div
                    class="heatmap-cell h-[9px] w-[9px] rounded-[2px] sm:h-[10px] sm:w-[10px] xl:h-[14px] xl:w-[14px]"
                    style={`background-color: color-mix(in srgb, var(--color-accent) ${day.level === 0 ? 0 : day.level * 22 + 12}%, var(--color-bg-subtle))`}
                    title={`${day.date}: ${day.count}`}
                  ></div>
                ))}
              </div>
            ))}
          </div>
          <a href={`https://github.com/${stats.login}`} target="_blank" rel="noopener noreferrer" class="font-sans text-xs text-[var(--color-text-secondary)] underline-offset-4 hover:text-[var(--color-text)] hover:underline">
            {dict.github.viewProfile} ↗
          </a>
        </div>
      </div>
    )}
    <dl class:list={["technology-rows", { "border-t border-[var(--color-border)] pt-3": hasData }]}>
      {groups.map((group) => (
        <div class="technology-row" data-reveal>
          <dt class="font-sans text-xs leading-relaxed text-[var(--color-text-secondary)]">{dict.stack.categories[group.key]}</dt>
          <dd class="flex min-w-0 flex-wrap gap-x-3 gap-y-1">
            {group.items.map((item) => (
              <span class="tech-chip">{item}</span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .technology-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .technology-row + .technology-row {
    border-top: 1px solid var(--color-border);
  }
  /* The heatmap runs oldest -> newest; trim from the left so wide screens
     get a full year and narrow ones only the recent weeks. */
  .heat-col:nth-child(-n + 32) { display: none; }
  @media (min-width: 640px) { .heat-col:nth-child(-n + 32) { display: grid; } .heat-col:nth-child(-n + 22) { display: none; } }
  @media (min-width: 1024px) { .heat-col:nth-child(-n + 22) { display: grid; } .heat-col:nth-child(-n + 8) { display: none; } }
  @media (min-width: 1280px) { .heat-col:nth-child(-n + 8) { display: grid; } }
  .tech-chip {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg-subtle);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  @media (max-width: 639px) {
    .technology-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
      padding-block: 0.875rem;
    }
    .technology-row dt {
      font-weight: 600;
      color: var(--color-text);
    }
    .technology-row dd { gap: 0.375rem; }

  }
  @media (min-width: 640px) {
    .technology-rows {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
    .technology-row {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 0.75rem;
      padding: 0;
    }
    .technology-row + .technology-row { border-top: 0; }
    .technology-row:last-child { grid-column: 1 / -1; }
    .technology-row dt { font-weight: 600; color: var(--color-text); }
    .technology-row dd { gap: 0.375rem; }
  }
  @media (min-width: 1024px) {
    .technology-rows { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.25rem; }
    .technology-row:last-child { grid-column: auto; }
    .technology-row + .technology-row {
      border-left: 1px solid var(--color-border);
      padding-left: 1.25rem;
    }
  }
</style>

<script>
  import { animate } from 'motion';

  const observers: IntersectionObserver[] = [];
  const animations: { stop: () => void }[] = [];
  function cleanup() {
    observers.splice(0).forEach((observer) => observer.disconnect());
    animations.splice(0).forEach((animation) => animation.stop());
  }

  function init() {
    cleanup();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const formatter = new Intl.NumberFormat(document.documentElement.lang.startsWith('pt') ? 'pt-BR' : 'en-US');

    const numbers = document.querySelectorAll<HTMLElement>('.stat-number[data-count-to]:not([data-init])');
    numbers.forEach((el) => (el.dataset.init = 'true'));
    if (numbers.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            animations.push(animate(0, Number(el.dataset.countTo), {
              duration: 1.4,
              ease: [0.16, 1, 0.3, 1],
              onUpdate(latest) {
                el.textContent = formatter.format(Math.round(latest));
              }
            }));
            observer.unobserve(el);
          });
        },
        { threshold: 0.4 }
      );
      observers.push(observer);
      numbers.forEach((el) => observer.observe(el));
    }

    const heatmap = document.querySelector<HTMLElement>('.heatmap:not([data-init])');
    if (heatmap) {
      heatmap.dataset.init = 'true';
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            animations.push(animate(heatmap, { opacity: [0, 1], transform: ['translateY(6px)', 'translateY(0px)'] }, { duration: 0.7, ease: [0.16, 1, 0.3, 1] }));
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.2 }
      );
      observers.push(observer);
      observer.observe(heatmap);
    }


  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>
