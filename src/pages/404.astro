---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/hero/ShaderBackground.astro';
---

<BaseLayout locale="pt" title="Página não encontrada · Luciano K. Dal Pai" noIndex>
  <section class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 text-center">
    <ShaderBackground id="not-found-canvas" />
    <div class="absolute inset-0 bg-[var(--color-bg)]/40" aria-hidden="true"></div>
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="relative z-10 flex flex-col items-center gap-10">
      <p class="glitch-404 font-display font-bold leading-none tracking-tighter text-[var(--color-text)]" style="font-size: clamp(6rem, 22vw, 15rem);" data-text="404">404</p>

      <div class="flex max-w-md flex-col gap-1 font-sans text-[var(--color-text-secondary)]">
        <p>Não encontramos esta página. O endereço pode ter mudado ou estar incorreto.</p>
        <p>We couldn’t find this page. The address may have changed or been entered incorrectly.</p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-primary" data-magnetic="0.3">Voltar ao início</a>
        <a href="/en" class="btn btn-ghost" data-magnetic="0.3">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .glitch-404 {
    position: relative;
    display: inline-block;
  }
  .glitch-404::before,
  .glitch-404::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    mix-blend-mode: screen;
    opacity: 0;
  }
  .glitch-404::before {
    color: var(--color-accent-glow);
    animation: glitch-shift-1 6s ease-in-out infinite;
  }
  .glitch-404::after {
    color: var(--color-accent-2-glow);
    animation: glitch-shift-2 6s ease-in-out infinite;
  }
  @keyframes glitch-shift-1 {
    0%, 92%, 100% { opacity: 0; transform: translate(0, 0); clip-path: inset(0 0 0 0); }
    93% { opacity: 0.8; transform: translate(-4px, 2px); clip-path: inset(10% 0 60% 0); }
    95% { opacity: 0.8; transform: translate(3px, -1px); clip-path: inset(60% 0 5% 0); }
    97% { opacity: 0; transform: translate(0, 0); }
  }
  @keyframes glitch-shift-2 {
    0%, 92%, 100% { opacity: 0; transform: translate(0, 0); clip-path: inset(0 0 0 0); }
    93% { opacity: 0.8; transform: translate(4px, -2px); clip-path: inset(40% 0 20% 0); }
    95% { opacity: 0.8; transform: translate(-3px, 1px); clip-path: inset(5% 0 70% 0); }
    97% { opacity: 0; transform: translate(0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .glitch-404::before,
    .glitch-404::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
