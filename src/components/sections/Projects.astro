---
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import projectsData from '../../data/projects.json';
import type { Dictionary, Locale } from '../../i18n/utils';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const projects = projectsData.filter((project) => project.enabled);

// Structured data so search engines can list the projects as software.
const projectsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: dict.projects.heading,
  itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'SoftwareSourceCode',
      name: project.translations[locale].name,
      description: project.translations[locale].result,
      codeRepository: project.repoUrl,
      ...(project.demoUrl ? { url: project.demoUrl } : {}),
      programmingLanguage: project.stack,
      author: { '@type': 'Person', name: 'Luciano K. Dal Pai', url: String(Astro.site) }
    }
  }))
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(projectsSchema)} />

<section id="projects" class="container-site scroll-mt-24 py-16 sm:py-24 lg:py-32">
  <SectionHeading index={dict.projects.index} heading={dict.projects.heading} subheading={dict.projects.subheading} />

  <div class="stack-list mt-8 sm:mt-14">
    {projects.map((project, index) => (
      <ProjectCard
        index={index + 1}
        id={project.id}
        repoUrl={project.repoUrl}
        demoUrl={project.demoUrl}
        stack={project.stack}
        translation={project.translations[locale]}
        dict={dict}
      />
    ))}
  </div>

  <div class="mt-10 flex justify-center sm:mt-14" data-reveal>
    <a href="https://github.com/lucianookdp" target="_blank" rel="noopener noreferrer me" class="btn btn-ghost" data-magnetic="0.25">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
        <path
          fill="currentColor"
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.221-.253-4.556-1.113-4.556-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.026 2.747-1.026.546 1.378.203 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
        />
      </svg>
      {dict.projects.viewMoreGithub}
      <svg class="btn-arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7" /><path d="M8 7h9v9" />
      </svg>
    </a>
  </div>
</section>
