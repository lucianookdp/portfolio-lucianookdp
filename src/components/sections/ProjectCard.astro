---
import RevealText from '../ui/RevealText.astro';
import { findProjectMedia } from '../../lib/media';
import type { Dictionary } from '../../i18n/utils';

interface Translation {
  name: string;
  subtitle: string;
  // Not every project frames as problem/solution — a personal build can just
  // be described. Those entries omit `problem` and render `result` as prose.
  problem?: string;
  result: string;
}

interface Props {
  index: number;
  id: string;
  demoUrl: string | null;
  demoMaintenance?: boolean;
  stack: string[];
  translation: Translation;
  dict: Dictionary;
}

const { index, id, demoUrl, demoMaintenance = false, stack, translation, dict } = Astro.props;
const media = findProjectMedia(id);

const COVER_ICONS: Record<string, string> = {
  'eleicoes-brasil': `<path d="M4 13h16v7H4z" /><path d="M8.5 13V4.5h7V13" /><path d="m10 8.2 1.6 1.6L15 6.4" />`,
  'lost-and-found': `<path d="m12 3 7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z" /><path d="m9 12 2 2 4-4" />`,
  rachai: `<path d="M12 3v18M3 12h18" /><circle cx="6" cy="6" r="3" /><circle cx="18" cy="18" r="3" />`,
  'cnpj-due-diligence': `<path d="M12 3v18" /><path d="M6 7h12" /><path d="M6 21h12" /><path d="M6 7 3 13a3 3 0 0 0 6 0L6 7Z" /><path d="M18 7l-3 6a3 3 0 0 0 6 0l-3-6Z" />`
};
const DEFAULT_ICON = `<path d="m8 9-4 3 4 3" /><path d="m16 9 4 3-4 3" /><path d="m14 6-4 12" />`;
const coverIcon = COVER_ICONS[id] ?? DEFAULT_ICON;
const number = String(index).padStart(2, '0');
---

<article class="stack-item project-panel card spot-card grid grid-cols-1 gap-4 p-4 sm:gap-8 sm:p-8 lg:grid-cols-2 lg:gap-12 lg:p-12" data-reveal>
  <span class="stack-shade" aria-hidden="true"></span>
  <div class="relative z-[1] flex min-w-0 flex-col">
    <p class="eyebrow flex items-center gap-3">
      <span class="text-[var(--color-accent-text)]">{number}</span>
      <span class="h-px w-6 bg-[var(--color-border-strong)]" aria-hidden="true"></span>
      <span>{stack[0]}</span>
    </p>

    <RevealText as="h3" class="mt-3 font-display text-xl font-semibold sm:mt-5 sm:text-4xl lg:text-5xl">{translation.name}</RevealText>

    <p class="mt-2 font-sans text-sm text-[var(--color-text-secondary)] sm:text-base">{translation.subtitle}</p>

    {stack.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1 sm:mt-5 sm:gap-1.5" aria-label={dict.projects.stackLabel}>
        {stack.map((tech) => (
          <li class="chip chip-sm">{tech}</li>
        ))}
      </ul>
    )}

    {translation.problem ? (
      <dl class="mt-5 flex flex-col gap-3 font-sans text-sm leading-relaxed sm:mt-8 sm:gap-5 sm:text-[15px]">
        <div>
          <dt class="eyebrow mb-1.5">{dict.projects.problem}</dt>
          <dd class="text-[var(--color-text-secondary)]">{translation.problem}</dd>
        </div>
        <div>
          <dt class="eyebrow mb-1.5">{dict.projects.result}</dt>
          <dd class="text-[var(--color-text)]">{translation.result}</dd>
        </div>
      </dl>
    ) : (
      <p class="mt-5 font-sans text-sm leading-relaxed text-[var(--color-text-secondary)] sm:mt-8 sm:text-[15px]">{translation.result}</p>
    )}

    <div class="mt-auto flex flex-wrap gap-2 pt-4 sm:gap-3 sm:pt-10">
      {demoUrl && !demoMaintenance && (
        <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" data-magnetic="0.2">
          {id === 'eleicoes-brasil' ? dict.projects.viewLive : dict.projects.viewDemo}
          <svg class="btn-arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7" /><path d="M8 7h9v9" />
          </svg>
        </a>
      )}
      {demoUrl && demoMaintenance && (
        <button type="button" disabled class="btn btn-ghost btn-sm cursor-not-allowed">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 2" />
          </svg>
          {dict.projects.demoMaintenance}
        </button>
      )}
      {!demoUrl && (
        <span class="btn btn-ghost btn-sm cursor-default opacity-60" aria-disabled="true">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 2" />
          </svg>
          {dict.projects.demoSoon}
        </span>
      )}
    </div>
  </div>

  <div class="relative z-[1] min-w-0">
    <div class="tilt h-full" data-tilt-max="7">
      {media ? (
        <div class="project-cover">
          {media.isVideo ? (
            <video src={media.src} class="absolute inset-0 h-full w-full object-cover" autoplay loop muted playsinline></video>
          ) : (
            <img src={media.src} alt={translation.name} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
          )}
          <span class="tilt-glare" aria-hidden="true"></span>
        </div>
      ) : (
        <div class="project-cover" aria-hidden="true">
          <span class="project-cover-orbit"></span>
          <div class="project-cover-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={coverIcon} />
          </div>
          <div class="project-cover-window">
            <span class="line" style="top: 1.6rem; width: 45%;"></span>
            <span class="line" style="top: 2.5rem; width: 70%;"></span>
            <span class="line" style="top: 3.4rem; width: 55%;"></span>
            <span class="line" style="top: 4.3rem; width: 30%;"></span>
          </div>
          <span class="tilt-glare"></span>
        </div>
      )}
    </div>
  </div>
</article>

<!-- Global on purpose: the stacked-panel effect in lib/interactions.ts and the
     Projects list target these classes. Shipped only on pages that render a card. -->
<style is:global>
.chip {
  display: inline-flex;
  align-items: center;
  border-radius: 9999px;
  padding: 0.3rem 0.7rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.02em;
  color: var(--color-accent-text);
  background: var(--color-accent-soft);
  border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
}
.chip-sm {
  padding: 0.2rem 0.55rem;
  font-size: 0.65rem;
}
@media (min-width: 640px) {
  .chip-sm {
    padding: 0.3rem 0.7rem;
    font-size: 0.7rem;
  }
}
/* ------------------------------------------------------------------ */
/*  Projects — stacked sticky panels + 3D tilt covers                    */
/* ------------------------------------------------------------------ */
.stack-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.stack-item {
  position: sticky;
  top: calc(5.5rem + var(--stack-index, 0) * 0.5rem);
  margin-bottom: 2.5rem;
  transform-origin: top center;
  will-change: transform;
}
.stack-item:last-child {
  margin-bottom: 0;
}
@media (max-width: 639px) {
  .stack-item {
    /* Tall cards scroll completely into view before the next one overlaps. */
    top: min(calc(5.5rem + var(--stack-index, 0) * 0.5rem), calc(100svh - var(--stack-height, 0px) - 1rem));
  }
}
@media (min-width: 1024px) {
  .stack-item {
    top: calc(6.5rem + var(--stack-index, 0) * 1rem);
    margin-bottom: 4rem;
  }
}

.project-panel {
  background: var(--color-bg-elevated);
  overflow: hidden;
  border-radius: 1.25rem;
  --stack-shade: 0;
}
@media (min-width: 640px) {
  .project-panel {
    border-radius: 1.75rem;
  }
}
/* Darkens a stacked panel as the next one slides over it, without making
   the panel itself translucent (which would let its text bleed through). */
.stack-shade {
  position: absolute;
  inset: 0;
  z-index: 3;
  border-radius: inherit;
  background: var(--color-bg);
  opacity: var(--stack-shade);
  pointer-events: none;
}

.tilt {
  transform-style: preserve-3d;
  transition: transform 500ms var(--ease-out-expo);
  will-change: transform;
}
.tilt-glare {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  background: radial-gradient(
    420px circle at var(--glare-x, 50%) var(--glare-y, 50%),
    rgb(255 255 255 / 0.18),
    transparent 60%
  );
  transition: opacity 300ms ease;
  mix-blend-mode: screen;
}
.tilt:hover .tilt-glare {
  opacity: 1;
}

.project-cover {
  position: relative;
  aspect-ratio: 2 / 1;
  border-radius: 1.25rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 15%, color-mix(in srgb, var(--color-accent) 38%, transparent), transparent 55%),
    radial-gradient(circle at 85% 90%, color-mix(in srgb, var(--color-accent-2) 30%, transparent), transparent 55%),
    var(--color-bg-subtle);
}
.project-cover::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: linear-gradient(color-mix(in srgb, var(--color-text) 6%, transparent) 1px, transparent 1px),
    linear-gradient(90deg, color-mix(in srgb, var(--color-text) 6%, transparent) 1px, transparent 1px);
  background-size: 32px 32px;
  mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
}
.project-cover-icon {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  transform: translateZ(40px);
}
@media (min-width: 640px) {
  .project-cover {
    aspect-ratio: 16 / 10;
  }
}
@media (min-width: 1024px) {
  .project-cover {
    aspect-ratio: 4 / 3;
  }
}
.project-cover-icon svg {
  width: 30%;
  height: 30%;
  color: var(--color-accent-text);
  filter: drop-shadow(0 18px 40px color-mix(in srgb, var(--color-accent) 45%, transparent));
}
.project-cover-orbit {
  position: absolute;
  inset: 12%;
  border-radius: 9999px;
  border: 1px dashed color-mix(in srgb, var(--color-accent) 35%, transparent);
  transform: translateZ(20px);
  animation: orbit-spin 40s linear infinite;
}
.project-cover-orbit::after {
  content: '';
  position: absolute;
  top: -5px;
  left: 50%;
  width: 10px;
  height: 10px;
  border-radius: 9999px;
  background: var(--color-accent-2-glow);
  box-shadow: 0 0 18px var(--color-accent-2-glow);
}
@keyframes orbit-spin {
  to {
    transform: translateZ(20px) rotate(360deg);
  }
}
.project-cover-window {
  position: absolute;
  left: 8%;
  right: 8%;
  bottom: -2%;
  height: 46%;
  border-radius: 0.9rem 0.9rem 0 0;
  border: 1px solid color-mix(in srgb, var(--color-border-strong) 80%, transparent);
  background: color-mix(in srgb, var(--color-bg-elevated) 80%, transparent);
  backdrop-filter: blur(10px);
  transform: translateZ(30px);
  overflow: hidden;
}
.project-cover-window::before {
  content: '';
  position: absolute;
  top: 0.55rem;
  left: 0.7rem;
  width: 0.45rem;
  height: 0.45rem;
  border-radius: 9999px;
  background: var(--color-accent-2);
  box-shadow: 0.8rem 0 0 var(--color-accent), 1.6rem 0 0 var(--color-border-strong);
}
.project-cover-window .line {
  position: absolute;
  left: 0.7rem;
  height: 0.35rem;
  border-radius: 9999px;
  background: color-mix(in srgb, var(--color-text) 12%, transparent);
}
</style>
