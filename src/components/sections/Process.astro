---
import SectionHeading from '../ui/SectionHeading.astro';
import type { Dictionary } from '../../i18n/utils';
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const steps = dict.process.steps;
const STEP_ICONS = [
  `<path d="M8 10h8" /><path d="M8 14h5" /><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z" />`,
  `<path d="M4 7h10" /><path d="M18 7h2" /><circle cx="16" cy="7" r="2" /><path d="M4 17h4" /><path d="M12 17h8" /><circle cx="10" cy="17" r="2" />`,
  `<rect x="3" y="3" width="18" height="18" rx="3" /><path d="M3 9h18" /><path d="M9 21V9" /><path d="m14 17 4-4" />`,
  `<path d="m8 8-4 4 4 4" /><path d="m16 8 4 4-4 4" /><path d="m14 5-4 14" />`,
  `<path d="M5 15c-1.5 1.5-2 4-2 6 2 0 4.5-.5 6-2" /><path d="M14.5 4.5c2.4-1.6 5-2 6.5-1.5-.5 1.5-.9 4.1-2.5 6.5L12 16l-4-4Z" /><path d="M9 12 4.7 11a2 2 0 0 1-1.1.6L2 12.3l3.5 1.3" /><path d="m12 15 1 4.3a2 2 0 0 1-.6 1.1l-.7 1.6-1.3-3.5" /><circle cx="15" cy="9" r="1.5" />`,
  `<path d="M21 12a9 9 0 0 1-15.5 6.2" /><path d="M3 12a9 9 0 0 1 15.5-6.2" /><path d="M21 4v5h-5" /><path d="M3 20v-5h5" />`
];


---
<section id="process" class="container-site scroll-mt-24 py-16 sm:py-24 lg:py-32">
  <SectionHeading index={dict.process.index} heading={dict.process.heading} subheading={dict.process.subheading} id="process-heading" />
  <div class="journey" data-journey>
    <div class="journey-intro">
      <p class="eyebrow">{dict.process.eyebrow}</p>
      <p class="journey-lead">{dict.process.intro}</p>
      <div class="journey-map" aria-hidden="true">
        <svg viewBox="0 0 280 140" fill="none">
          <path class="journey-map-base" d="M24 36H244V104H24" />
          <path class="journey-map-route" d="M24 36H244V104H24" pathLength="1" />
          {[[24,36],[134,36],[244,36],[244,104],[134,104],[24,104]].map(([x,y],i) => (
            <g class="journey-map-stop" data-journey-stop><circle cx={x} cy={y} r="17" /><text x={x} y={y} dy=".35em" text-anchor="middle">{String(i+1).padStart(2,'0')}</text></g>
          ))}
        </svg>
      </div>
    </div>
    <ol class="journey-steps" aria-labelledby="process-heading">
      {steps.map((step,index) => (
        <li class="journey-step" data-journey-step>
          <span class="journey-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
          <div class="journey-card">
            <span class="journey-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={STEP_ICONS[index]} /></span>
            <div class="journey-copy"><h3>{step.title}</h3><p>{step.description}</p></div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<script>
  let teardown: (() => void) | undefined;
  function initProcess() {
    teardown?.();
    const root = document.querySelector<HTMLElement>('[data-journey]');
    if (!root) return;
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-journey-step]'));
    const stops = Array.from(root.querySelectorAll<SVGElement>('[data-journey-stop]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let observer: IntersectionObserver | undefined;
    let furthest = -1;
    const activate = (index: number) => {
      furthest = Math.max(furthest, index);
      steps.forEach((step, i) => step.classList.toggle('is-reached', i <= furthest));
      stops.forEach((stop, i) => stop.classList.toggle('is-reached', i <= furthest));
      root.style.setProperty('--journey-progress', String(Math.max(0, furthest) / Math.max(1, steps.length - 1)));
    };
    const setup = () => {
      observer?.disconnect();
      if (reduced.matches || !('IntersectionObserver' in window)) { activate(steps.length - 1); return; }
      observer = new IntersectionObserver(entries => {
        for (const entry of entries) if (entry.isIntersecting) {
          activate(steps.indexOf(entry.target as HTMLElement));
          observer?.unobserve(entry.target);
        }
      }, { rootMargin: '0px 0px -15% 0px', threshold: 0.25 });
      steps.forEach(step => observer?.observe(step));
    };
    setup();
    reduced.addEventListener('change', setup);
    teardown = () => { observer?.disconnect(); reduced.removeEventListener('change', setup); };
  }
  document.addEventListener('astro:page-load', initProcess);
  document.addEventListener('astro:before-swap', () => { teardown?.(); teardown = undefined; });
</script>
<style is:global>
.journey{--journey-progress:0;display:grid;gap:2.5rem;margin-top:3rem}
.journey-lead{max-width:25ch;margin-top:1rem;font:500 clamp(1.5rem,2.5vw,2rem)/1.4 var(--font-display);letter-spacing:-.035em}
.journey-map{max-width:280px;margin-top:2rem}.journey-map svg{display:block;width:100%;overflow:visible}
.journey-map-base{stroke:var(--color-border-strong);stroke-width:1.5}
.journey-map-route{stroke:var(--color-accent-text);stroke-width:1.5;stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--journey-progress))}
.journey-map-stop circle{fill:var(--color-bg);stroke:var(--color-border-strong)}.journey-map-stop text{fill:var(--color-text-secondary);font:10px var(--font-mono)}
.journey-map-stop.is-reached circle{fill:var(--color-accent);stroke:var(--color-accent)}.journey-map-stop.is-reached text{fill:var(--color-on-accent)}
.journey-steps{list-style:none;margin:0;padding:0}
.journey-step{position:relative;display:grid;grid-template-columns:2.5rem minmax(0,1fr);gap:1.25rem;padding-bottom:1.25rem}
.journey-step:not(:last-child)::before,.journey-step:not(:last-child)::after{content:'';position:absolute;left:calc(1.25rem - .5px);top:2.5rem;bottom:0;width:1px;background:var(--color-border-strong)}
.journey-step:not(:last-child)::after{background:var(--color-accent-text);transform:scaleY(0);transform-origin:top}.journey-step.is-reached::after{transform:scaleY(1)}
.journey-number{position:relative;z-index:1;display:grid;place-items:center;width:2.5rem;height:2.5rem;border:1px solid var(--color-border-strong);border-radius:50%;background:var(--color-bg);color:var(--color-text-secondary);font:.7rem var(--font-mono)}
.journey-card{display:grid;grid-template-columns:2.75rem minmax(0,1fr);align-items:start;gap:1.25rem;padding:1.5rem;border:1px solid var(--color-border);border-radius:1.1rem;background:var(--color-bg-elevated)}
.journey-icon{display:grid;place-items:center;width:2.75rem;height:2.75rem;border-radius:.8rem;color:var(--color-text-secondary);background:var(--color-bg-subtle)}.journey-icon svg{width:1.5rem;height:1.5rem}
.journey-copy h3{font:600 clamp(1.15rem,1.8vw,1.45rem)/1.25 var(--font-display);letter-spacing:-.025em}.journey-copy p{max-width:49ch;margin-top:.65rem;color:var(--color-text-secondary);font-size:.9rem;line-height:1.7}
.journey-step.is-reached .journey-number{color:var(--color-on-accent);background:var(--color-accent);border-color:var(--color-accent)}.journey-step.is-reached .journey-icon{color:var(--color-accent-text);background:var(--color-accent-soft)}.journey-step.is-reached .journey-card{border-color:var(--color-border-strong)}.journey-step:last-child{padding-bottom:0}
@media(min-width:900px){.journey{grid-template-columns:minmax(0,.75fr) minmax(0,1.4fr);gap:clamp(3rem,6vw,6rem)}.journey-intro{position:sticky;top:8rem;align-self:start}.journey-card{padding:1.75rem}}
@media(max-width:599px){.journey{gap:2rem}.journey-map{display:none}.journey-lead{max-width:32ch}.journey-step{gap:.75rem;grid-template-columns:2rem minmax(0,1fr)}.journey-number{width:2rem;height:2rem;font-size:.65rem}.journey-step:not(:last-child)::before,.journey-step:not(:last-child)::after{left:calc(1rem - .5px);top:2rem}.journey-card{grid-template-columns:1fr;padding:1.25rem;gap:1rem}.journey-icon{width:2.25rem;height:2.25rem}}
@media(max-height:540px){.journey-intro{position:static}}
@media(prefers-reduced-motion:no-preference){.journey-map-route{transition:stroke-dashoffset .8s ease}.journey-map-stop circle,.journey-map-stop text{transition:fill .4s,stroke .4s}.journey-number,.journey-icon,.journey-card{transition:color .45s,background-color .45s,border-color .45s}.journey-step::after{transition:transform .8s ease}.journey-step.is-reached .journey-icon svg{animation:journey-icon-in .6s var(--ease-out-expo) both}@keyframes journey-icon-in{from{transform:translateY(5px) scale(.9)}to{transform:none}}}
</style>
